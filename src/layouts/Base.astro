---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0912" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a theme the visitor chose before, before first paint. No choice: follow the system.
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('cg-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo {...props} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
    <style>
      .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 50;
        padding: 0.6rem 1rem;
        background: var(--ink);
        color: var(--paper);
        border-radius: var(--radius-sm);
      }
      .skip:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
