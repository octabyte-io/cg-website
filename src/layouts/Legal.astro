---
// The one layout for every legal document: the page hero with breadcrumbs (Home > Legal > page),
// a "Last updated" date from legal.ts, numbered sections (legal clauses are a real sequence, so
// they are numbered in the HTML itself and survive copying and printing), a sticky table of
// contents beside them on wide screens, links to the other documents, and print styles.
//
// Section bodies are HTML strings, so the contents list and the headings come from one array and
// can never disagree.
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import { breadcrumbSchema } from '../data/schema';
import { legal, legalDocs, formatLegalDate } from '../data/legal';

export interface LegalSection {
  id: string;
  title: string;
  html: string;
}
interface Props {
  /** <title>, 50-60 characters. */
  title: string;
  /** Meta description, 140-160 characters. */
  description: string;
  /** The page's one <h1>. */
  heading: string;
  lede: string;
  /** This document's path, as listed in legalDocs. */
  path: string;
  /** Its breadcrumb name. */
  name: string;
  sections: LegalSection[];
}
const { title, description, heading, lede, path, name, sections } = Astro.props;
const trail = [
  { name: 'Legal', path: '/legal' },
  { name, path },
];
const others = legalDocs.filter((d) => d.path !== path);
const hasIntro = Astro.slots.has('default');
---
<Base title={title} description={description} schema={[breadcrumbSchema(trail)]}>
  <PageHero title={heading} lede={lede} trail={trail}>
    <p class="updated">
      Last updated <time datetime={legal.updatedDate}>{formatLegalDate(legal.updatedDate)}</time>
    </p>
  </PageHero>

  <div class="wrap legal" data-reveal>
    <nav class="toc" data-spy aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>
        {sections.map((s, i) => (
          <li><a href={`#${s.id}`}><span class="n">{i + 1}.</span><span>{s.title}</span></a></li>
        ))}
      </ol>
    </nav>

    <article class="doc">
      {hasIntro && <div class="intro"><slot /></div>}
      {sections.map((s, i) => (
        <section id={s.id} aria-labelledby={`${s.id}-title`}>
          <h2 id={`${s.id}-title`}><span class="n">{i + 1}.</span> {s.title}</h2>
          <div class="body" set:html={s.html} />
        </section>
      ))}

      <aside class="others" aria-labelledby="others-title">
        <h2 id="others-title">Other legal documents</h2>
        <ul>
          {others.map((d) => (
            <li><a href={d.path}>{d.name}</a><span>{d.summary}</span></li>
          ))}
        </ul>
        <p><a href="/legal">All legal documents</a></p>
      </aside>
    </article>
  </div>
</Base>

<style>
  .updated {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .legal {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-8) var(--space-9);
  }

  /* ---- Contents ---- */
  .toc {
    position: sticky;
    top: calc(64px + var(--space-5));
    max-height: calc(100svh - 64px - var(--space-7));
    overflow-y: auto;
    padding-right: var(--space-2);
  }
  .toc h2 {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: flex;
    gap: var(--space-2);
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem var(--space-3);
    border-left: 1px solid transparent;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .toc a:hover {
      color: var(--ink);
      border-left-color: var(--brand);
    }
  }
  /* The section being read (motion.ts marks it), the same treatment as hover. */
  .toc a[aria-current='location'] {
    color: var(--ink);
    border-left-color: var(--brand);
  }
  .toc .n {
    min-width: 1.5em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  /* ---- The document ---- */
  .doc {
    max-width: 68ch;
    min-width: 0;
  }
  .intro {
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .intro > :global(* + *) {
    margin-top: var(--space-4);
  }
  .intro :global(p) {
    color: var(--ink-2);
  }
  .doc section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .doc section:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .doc section h2 {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .doc section h2 .n {
    flex: none;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }
  .body > :global(* + *) {
    margin-top: var(--space-4);
  }
  .body :global(p),
  .body :global(li),
  .body :global(dd) {
    color: var(--ink-2);
  }
  .body :global(h3) {
    margin-top: var(--space-5);
    font-size: var(--text-md);
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0;
  }
  .body :global(h3 + p),
  .body :global(h3 + ul) {
    margin-top: var(--space-2);
  }
  .body :global(ul),
  .body :global(ol) {
    margin-bottom: 0;
    padding-left: 1.25rem;
  }
  .body :global(li + li) {
    margin-top: var(--space-2);
  }
  .body :global(li)::marker {
    color: var(--muted);
  }
  .body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .body :global(a),
  .intro :global(a),
  .others a {
    color: var(--brand);
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    overflow-wrap: anywhere;
  }
  .body :global(a:hover),
  .intro :global(a:hover),
  .others a:hover {
    color: var(--brand-hi);
    text-decoration-color: currentColor;
  }
  .body :global(.table-wrap) {
    margin-top: var(--space-5);
  }
  .body :global(.note) {
    margin-top: var(--space-5);
  }

  /* ---- The other documents ---- */
  .others {
    margin-top: var(--space-7);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-2);
  }
  .others h2 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .others li {
    display: grid;
    gap: 0.1rem;
  }
  .others li span {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .others a {
    font-weight: 500;
  }
  /* A 44px tap target per document; the label sits at its foot, next to its summary. */
  .others li a {
    display: inline-flex;
    align-items: flex-end;
    justify-self: start;
    min-height: 44px;
  }
  .others p {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  @media (max-width: 960px) {
    .legal {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding-top: var(--space-6);
    }
    .toc {
      position: static;
      max-height: none;
      overflow: visible;
      padding: var(--space-5);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
    }
    .toc ol {
      border-left: 0;
    }
    .toc a {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
      min-height: 44px;
      align-items: center;
    }
    .toc a:hover {
      border-left: 0;
    }
  }
  /* Narrow screens: a table marked .stack becomes one block per row, each cell labelled. */
  @media (max-width: 640px) {
    .body :global(.table-wrap:has(.stack)) {
      overflow: visible;
      border: 0;
      background: transparent;
    }
    .body :global(.stack thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .body :global(.stack),
    .body :global(.stack tbody),
    .body :global(.stack tr),
    .body :global(.stack th),
    .body :global(.stack td) {
      display: block;
      width: 100%;
    }
    .body :global(.stack tr) {
      padding: var(--space-4);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
    }
    .body :global(.stack tr + tr) {
      margin-top: var(--space-3);
    }
    .body :global(.stack th),
    .body :global(.stack td) {
      padding: 0;
      border: 0;
      overflow-wrap: anywhere;
    }
    .body :global(.stack th) {
      margin-bottom: var(--space-2);
      font-size: var(--text-md);
    }
    .body :global(.stack td + td),
    .body :global(.stack th + td) {
      margin-top: var(--space-2);
    }
    .body :global(.stack td[data-label]::before) {
      content: attr(data-label);
      display: block;
      font-size: var(--text-xs);
      color: var(--muted);
    }
  }
  @media (max-width: 520px) {
    .others {
      padding: var(--space-5);
    }
    .doc section h2 {
      gap: var(--space-2);
    }
  }

  /* ---- Print: the document alone, black on white, with link targets written out ---- */
  @media print {
    :global(:root) {
      color-scheme: light;
      --paper: Canvas;
      --paper-2: Canvas;
      --surface: Canvas;
      --ink: CanvasText;
      --ink-2: CanvasText;
      --muted: CanvasText;
      --brand: CanvasText;
      --brand-hi: CanvasText;
      --line: GrayText;
    }
    :global(.site-header),
    :global(.site-footer),
    :global(.skip),
    :global(.page-hero .grid-bg),
    :global(.page-hero .beam),
    :global(.crumbs),
    .toc,
    .others {
      display: none !important;
    }
    :global(.page-hero) {
      padding-block: 0 1rem;
    }
    :global(.page-hero h1) {
      max-width: none;
      font-size: 24pt;
    }
    :global(.page-hero .lede) {
      font-size: 12pt;
    }
    .legal {
      display: block;
      padding-block: 1rem 0;
    }
    .doc {
      max-width: none;
      font-size: 11pt;
    }
    .doc section {
      padding-block: 0.75rem;
      break-inside: auto;
    }
    .doc section h2 {
      font-size: 14pt;
      break-after: avoid;
    }
    .body :global(a[href^='http']::after),
    .body :global(a[href^='mailto:']::after) {
      content: ' (' attr(href) ')';
      font-size: 0.9em;
    }
    .body :global(a[href^='/']::after) {
      content: ' (cloudgate.octabyte.io' attr(href) ')';
      font-size: 0.9em;
    }
  }
</style>
