---
// Hero prototype B: "Ask your agent". AI-first, the conversation is the product shot. Not indexed.
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { site, trialDays } from '../../data/site';
---

<Base title="Hero prototype B: ask your AI agent to deploy" description="Prototype of an AI-first home page hero for Cloudgate, kept out of search." noindex>
  <section class="hero" data-loop>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="beam" aria-hidden="true"></div>
    <div class="wrap inner">
      <h1>Your AI built the app. <br />Cloudgate puts it online.</h1>
      <p class="lede">
        Deploy to servers you own, AWS or Google Cloud by asking your AI agent, clicking Deploy, or running one
        command. The agent gets its own key and role, and every call it makes is in your audit log.
      </p>
      <div class="actions">
        <a class="btn btn--primary btn--lg" href={site.signUp}>Start {trialDays}-day free trial</a>
        <a class="btn btn--ghost btn--lg" href="/ai-agents">Connect your agent</a>
      </div>

      <div class="chat" aria-hidden="true">
        <div class="thread">
          <p class="msg you" style="--i:0">Fix the checkout bug and send me a preview.</p>
          <div class="msg agent" style="--i:1">
            <p>Pushed <code>fix-checkout</code>. Asking Cloudgate for a preview.</p>
            <ul class="calls">
              <li style="--i:2"><span class="tool">create_preview</span><span class="res">queued, expires in 60 minutes</span></li>
              <li style="--i:3"><span class="tool">read_deployment_log</span><span class="res">build finished · DATABASE_URL=<b>••••••</b></span></li>
              <li style="--i:4"><span class="tool">get_service_health</span><span class="res ok">container healthy</span></li>
            </ul>
          </div>
          <div class="card" style="--i:5">
            <span class="card-mark"><Mark size={26} /></span>
            <span class="card-txt">
              <b>Preview is live</b>
              <span>https://fix-checkout.shop.example.com</span>
            </span>
            <span class="pill"><i></i>Running</span>
          </div>
        </div>
        <div class="composer">
          <span class="typed">Why did last night’s deploy fail?</span>
          <span class="send">↵</span>
        </div>
      </div>
      <p class="aside">Works with any MCP client. <a href="/ai-agents">How agents work in Cloudgate</a>.</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-9) var(--space-8);
  }
  .beam {
    position: absolute;
    z-index: -1;
    top: 30%;
    left: 50%;
    width: 70%;
    height: 60%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--beam-a), transparent 70%), radial-gradient(closest-side, var(--beam-c), transparent);
    filter: blur(90px);
    opacity: 0.28;
  }
  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    letter-spacing: -0.045em;
  }
  .lede {
    max-width: 60ch;
  }
  .actions {
    justify-content: center;
  }
  .aside {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .chat {
    width: min(760px, 100%);
    margin-top: var(--space-6);
    text-align: left;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(180deg, color-mix(in srgb, var(--beam-b) 60%, transparent), var(--line) 50%) border-box;
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 1px 0 var(--panel-top),
      0 40px 100px -40px var(--glow);
    overflow: hidden;
  }
  .thread {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
  }
  .msg {
    margin: 0;
    max-width: 85%;
    font-size: var(--text-md);
  }
  .msg p {
    margin: 0;
  }
  .you {
    justify-self: end;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md) var(--radius-md) 4px var(--radius-md);
    background: var(--brand-tint);
    color: var(--ink);
  }
  .agent {
    color: var(--ink-2);
    display: grid;
    gap: var(--space-3);
  }
  .agent code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--brand);
  }
  .calls {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .calls li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .tool {
    color: var(--ink);
  }
  .tool::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 0.9em;
    margin-right: 0.5rem;
    border-radius: 2px;
    background: var(--slice-2);
    vertical-align: -0.1em;
  }
  .res {
    color: var(--muted);
  }
  .res b {
    font-weight: 400;
    color: var(--ink-2);
  }
  .ok {
    color: var(--live);
  }
  .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  .card-mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card-txt {
    display: grid;
    min-width: 0;
  }
  .card-txt b {
    font-weight: 600;
    color: var(--ink);
  }
  .card-txt span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--brand);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    background: var(--live-tint);
    color: var(--live);
  }
  .pill i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin: 0 var(--space-4) var(--space-4);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--muted);
  }
  .typed {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .send {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--brand);
    color: var(--on-brand);
  }

  /* Motion: the conversation plays in once, line by line (the HTML always holds the full text). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .thread [style*='--i'] {
      animation: line-in 500ms var(--ease-out) both;
      animation-delay: calc(500ms + var(--i) * 450ms);
    }
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-8) var(--space-7);
    }
    h1 br {
      display: none;
    }
    .thread {
      padding: var(--space-4);
    }
    .msg {
      max-width: 100%;
    }
    .card {
      grid-template-columns: auto 1fr;
    }
    .card .pill {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
