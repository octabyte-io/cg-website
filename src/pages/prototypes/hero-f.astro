---
// Hero prototype F: "Above the clouds". Layers of clouds drawn from the mark's own cloud shape drift
// at three speeds; the Services you run float on them. Not indexed.
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { site, trialDays } from '../../data/site';
import { templatesHome } from '../../data/template-links';

// One cloud: the mark's silhouette (a pill and three circles), placed and sized per layer.
type C = { x: number; y: number; s: number };
const back: C[] = [{ x: 40, y: 40, s: 5 }, { x: 420, y: 60, s: 4 }, { x: 760, y: 30, s: 5.5 }, { x: 1150, y: 55, s: 4.5 }, { x: 1500, y: 35, s: 5 }];
const mid: C[] = [{ x: -60, y: 120, s: 6 }, { x: 380, y: 140, s: 7 }, { x: 880, y: 110, s: 6.5 }, { x: 1320, y: 135, s: 7 }];
const front: C[] = [{ x: -120, y: 210, s: 9 }, { x: 420, y: 230, s: 8 }, { x: 900, y: 205, s: 9.5 }, { x: 1420, y: 225, s: 8.5 }];
---

<Base title="Hero prototype F: above the clouds" description="Prototype of a cloudscape home page hero for Cloudgate, kept out of search." noindex>
  <section class="hero" data-loop>
    <div class="sun" aria-hidden="true"></div>
    <div class="wrap inner">
      <h1>Your own cloud, <br />on servers you own</h1>
      <p class="lede">
        Cloudgate builds and runs your apps, databases and AI models on your own server, AWS or Google Cloud, with
        domains, https, backups and monitoring set up. Click Deploy, run one command, or let your AI agent do it.
      </p>
      <div class="actions">
        <a class="btn btn--primary btn--lg" href={site.signUp}>Start {trialDays}-day free trial</a>
        <a class="btn btn--ghost btn--lg" href={templatesHome}>Deploy an app template</a>
      </div>
      <p class="aside">Rather run it yourself? <a href="/self-hosted">Cloudgate is free to self-host</a>.</p>
    </div>

    <div class="scape" aria-hidden="true">
      <svg viewBox="0 0 1800 360" preserveAspectRatio="xMidYMax slice">
        <defs>
          <g id="cloud"><rect x="0" y="18" width="58" height="19" rx="9.5" /><circle cx="16" cy="19" r="9.5" /><circle cx="34" cy="13" r="13" /><circle cx="47" cy="20.5" r="8" /></g>
        </defs>
        <g class="layer l-back">{[0, 1800].map((o) => back.map((c) => <use href="#cloud" transform={`translate(${c.x + o} ${c.y}) scale(${c.s})`} />))}</g>
        <g class="layer l-mid">{[0, 1800].map((o) => mid.map((c) => <use href="#cloud" transform={`translate(${c.x + o} ${c.y}) scale(${c.s})`} />))}</g>
        <g class="layer l-front">{[0, 1800].map((o) => front.map((c) => <use href="#cloud" transform={`translate(${c.x + o} ${c.y}) scale(${c.s})`} />))}</g>
      </svg>

      <div class="chips">
        <span class="chip c1"><span class="slice"></span>shop-web<b>Running</b></span>
        <span class="chip c2"><span class="slice slice--2"></span>postgres<b>Backed up</b></span>
        <span class="chip c3"><Mark size={22} /></span>
        <span class="chip c4"><span class="slice slice--3"></span>n8n<b>https on</b></span>
        <span class="chip c5"><span class="slice slice--2"></span>llama on Ollama<b>Running</b></span>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--space-9);
    min-height: 960px;
    /* Sky: deep at the top, warming toward the horizon. */
    background: linear-gradient(
      180deg,
      var(--paper) 0%,
      color-mix(in srgb, var(--beam-a) 16%, var(--paper)) 45%,
      color-mix(in srgb, var(--beam-c) 26%, var(--paper)) 78%
    );
  }
  .sun {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: 120px;
    width: 900px;
    height: 500px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--beam-c) 55%, transparent), transparent);
    filter: blur(30px);
    opacity: 0.7;
  }
  .inner {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  h1 {
    font-size: clamp(2.4rem, 6.2vw, 4.8rem);
    letter-spacing: -0.045em;
  }
  .lede {
    max-width: 60ch;
  }
  .actions {
    justify-content: center;
  }
  .aside {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .scape {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 360px;
  }
  .scape svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .l-back {
    fill: color-mix(in srgb, var(--slice-3) 40%, var(--paper));
    opacity: 0.7;
  }
  .l-mid {
    fill: color-mix(in srgb, var(--slice-2) 32%, var(--paper));
  }
  .l-front {
    fill: color-mix(in srgb, var(--slice-1) 16%, var(--paper));
  }

  .chips {
    position: absolute;
    inset: 0;
    max-width: var(--column);
    margin-inline: auto;
  }
  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink);
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(180deg, var(--line-strong), var(--line)) border-box;
    border: 1px solid transparent;
    box-shadow: 0 16px 40px -18px var(--glow);
    white-space: nowrap;
  }
  .chip b {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--live);
  }
  .chip .slice {
    width: 4px;
    height: 14px;
    border-radius: 2px;
  }
  .c1 { left: 6%; top: 70px; }
  .c2 { left: 26%; top: 150px; }
  .c3 { left: 50%; top: 40px; translate: -50% 0; padding: 0.7rem 0.9rem; border-radius: 16px; }
  .c4 { right: 24%; top: 140px; }
  .c5 { right: 4%; top: 60px; }

  /* Motion: each layer drifts left at its own pace (two copies, so the loop never shows a seam);
     the chips bob gently. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .layer {
      animation: drift linear infinite;
    }
    :global(.js) .l-back { animation-duration: 160s; }
    :global(.js) .l-mid { animation-duration: 110s; }
    :global(.js) .l-front { animation-duration: 70s; }
    :global(.js) .chip {
      animation: bob 6s ease-in-out infinite alternate;
    }
    :global(.js) .c2 { animation-delay: -2s; }
    :global(.js) .c3 { animation-delay: -4s; }
    :global(.js) .c4 { animation-delay: -1s; }
    :global(.js) .c5 { animation-delay: -3s; }
  }
  @keyframes drift {
    to {
      transform: translateX(-1800px);
    }
  }
  @keyframes bob {
    to {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 940px;
      padding-top: var(--space-8);
    }
    h1 br {
      display: none;
    }
    .scape {
      height: 280px;
    }
    .c2,
    .c4 {
      display: none;
    }
    .c1 { left: 4%; top: 90px; }
    .c5 { right: 4%; top: 150px; }
  }
  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
