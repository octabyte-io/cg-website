---
// Hero prototype H: "Aurora". Slow ribbons of beam-coloured light across a night sky (a dawn sky in the
// light theme), centred copy, and the mark on a horizon with three light pillars for the three ways in.
// Not indexed.
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { site, trialDays } from '../../data/site';
import { templatesHome } from '../../data/template-links';

const pillars = [
  { label: 'Console', cls: 'p1' },
  { label: 'AI agent', cls: 'p2' },
  { label: 'Terminal', cls: 'p3' },
];
---

<Base title="Hero prototype H: aurora" description="Prototype of a calm aurora home page hero for Cloudgate, kept out of search." noindex>
  <section class="hero" data-loop>
    <div class="sky" aria-hidden="true">
      <span class="ribbon r1"></span>
      <span class="ribbon r2"></span>
      <span class="ribbon r3"></span>
      <span class="ribbon r4"></span>
    </div>

    <div class="wrap inner">
      <h1>Deploy to servers you own, without the ops work</h1>
      <p class="lede">
        Cloudgate builds and runs your apps, databases and AI models on your own server, AWS or Google Cloud, with
        domains, https, backups and monitoring set up. Click Deploy, run one command, or let your AI agent do it.
      </p>
      <div class="actions">
        <a class="btn btn--primary btn--lg" href={site.signUp}>Start {trialDays}-day free trial</a>
        <a class="btn btn--ghost btn--lg" href={templatesHome}>Deploy an app template</a>
      </div>

      <div class="stage" role="img" aria-label="Three ways into Cloudgate: the console, your AI agent and your terminal.">
        <ol class="pillars" aria-hidden="true">
          {pillars.map((p) => (
            <li class={`pillar ${p.cls}`}>
              <span class="label">{p.label}</span>
              <span class="shaft"><span class="spark"></span></span>
            </li>
          ))}
        </ol>
        <div class="horizon" aria-hidden="true"></div>
        <Mark size={72} class="mark" />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-9) var(--space-8);
    background: linear-gradient(to bottom, var(--paper-2), var(--paper) 70%);
  }

  /* The sky: a few large blurred gradient shapes. Only transform moves them. */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .ribbon {
    position: absolute;
    top: -18%;
    border-radius: 50%;
    filter: blur(60px);
    will-change: transform;
  }
  .r1 {
    left: -10%;
    width: 70%;
    height: 34%;
    background: radial-gradient(closest-side, var(--beam-a), transparent);
    opacity: 0.55;
    transform: rotate(-8deg);
  }
  .r2 {
    left: 25%;
    width: 60%;
    height: 26%;
    top: -6%;
    background: radial-gradient(closest-side, var(--beam-b), transparent);
    opacity: 0.4;
    transform: rotate(6deg);
  }
  .r3 {
    right: -12%;
    width: 55%;
    height: 30%;
    background: radial-gradient(closest-side, var(--beam-c), transparent);
    opacity: 0.32;
    transform: rotate(-4deg);
  }
  .r4 {
    left: 10%;
    width: 80%;
    height: 14%;
    top: 8%;
    background: radial-gradient(closest-side, var(--beam-b), transparent);
    opacity: 0.18;
  }
  /* Light theme: the same ribbons, softer, read as a dawn sky. */
  :global(:root[data-theme='light']) .r1 { opacity: 0.4; }
  :global(:root[data-theme='light']) .r2 { opacity: 0.34; }
  :global(:root[data-theme='light']) .r3 { opacity: 0.55; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .r1 { opacity: 0.4; }
    :global(:root:not([data-theme='dark'])) .r2 { opacity: 0.34; }
    :global(:root:not([data-theme='dark'])) .r3 { opacity: 0.55; }
  }

  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.045em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .lede {
    max-width: 60ch;
    margin: 0;
    color: var(--ink-2);
  }
  .actions {
    justify-content: center;
  }

  /* The stage: three pillars, a horizon, the mark on it. */
  .stage {
    position: relative;
    width: min(100%, 620px);
    height: 230px;
    margin-top: var(--space-6);
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0 0 46px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .pillar {
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
    gap: var(--space-2);
  }
  .p1 { --c: var(--slice-1); padding-top: 34px; }
  .p2 { --c: var(--slice-2); padding-top: 0; }
  .p3 { --c: var(--slice-3); padding-top: 34px; }
  .label {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .shaft {
    position: relative;
    overflow: hidden;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(to top, var(--c), transparent);
    opacity: 0.85;
  }
  .p2 .shaft {
    margin-bottom: 22px; /* rises from the mark's keyhole */
  }
  .spark {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 40px;
    background: linear-gradient(to top, transparent, var(--beam-c), transparent);
    opacity: 0;
  }

  .horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 46px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--line-strong) 20%, var(--brand) 50%, var(--line-strong) 80%, transparent);
  }
  .horizon::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    top: -30px;
    height: 60px;
    background: radial-gradient(closest-side, var(--glow), transparent);
  }
  .stage :global(.mark) {
    position: absolute;
    left: 50%;
    bottom: 46px;
    transform: translateX(-50%);
    width: 72px;
    height: auto;
  }

  /* Motion: the ribbons drift on long loops; a spark climbs each pillar in turn. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .r1 { animation: drift-a 19s var(--ease-in-out) infinite alternate; }
    :global(.js) .r2 { animation: drift-b 23s var(--ease-in-out) infinite alternate; }
    :global(.js) .r3 { animation: drift-c 17s var(--ease-in-out) infinite alternate; }
    :global(.js) .r4 { animation: drift-d 27s var(--ease-in-out) infinite alternate; }
    :global(.js) .spark { animation: climb 6s var(--ease-in-out) infinite; }
    :global(.js) .p2 .spark { animation-delay: 2s; }
    :global(.js) .p3 .spark { animation-delay: 4s; }
  }
  @keyframes drift-a {
    from { transform: translate3d(-4%, 0, 0) rotate(-8deg) scaleX(1); }
    to { transform: translate3d(14%, 12%, 0) rotate(-2deg) scaleX(1.15); }
  }
  @keyframes drift-b {
    from { transform: translate3d(6%, 4%, 0) rotate(6deg); }
    to { transform: translate3d(-16%, -4%, 0) rotate(-3deg) scaleX(1.2); }
  }
  @keyframes drift-c {
    from { transform: translate3d(0, 0, 0) rotate(-4deg); }
    to { transform: translate3d(-18%, 14%, 0) rotate(5deg) scaleX(1.1); }
  }
  @keyframes drift-d {
    from { transform: translate3d(-10%, 0, 0) scaleY(1); }
    to { transform: translate3d(10%, 30%, 0) scaleY(1.4); }
  }
  @keyframes climb {
    0% { transform: translateY(0); opacity: 0; }
    10% { opacity: 1; }
    45% { transform: translateY(-260px); opacity: 0; }
    100% { transform: translateY(-260px); opacity: 0; }
  }

  @media (max-width: 960px) {
    .hero {
      padding-block: var(--space-8) var(--space-7);
    }
  }
  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .stage {
      height: 200px;
    }
    .ribbon {
      filter: blur(40px);
    }
    .r1, .r3 { height: 22%; }
  }
</style>
