---
import { templatesHome } from '../data/template-links';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { faqSchema, breadcrumbSchema } from '../data/schema';

const trail = [{ name: 'CLI', path: '/cli' }];

// One-line descriptions from each command's own summary in cli/src/commands/*.ts.
const commandGroups = [
  {
    id: 'login',
    name: 'Logging in',
    commands: [
      { cmd: 'cloudgate login', text: 'Log in to an Instance through your browser. Add --instance <url> for a self-hosted one.' },
      { cmd: 'cloudgate whoami', text: 'Show who you are logged in as, where, and when your key ends.' },
      { cmd: 'cloudgate instance list', text: 'Show the Instances you are logged in to, marking the current one.' },
      { cmd: 'cloudgate instance use <url>', text: 'Switch the current Instance.' },
      { cmd: 'cloudgate logout', text: "Log out and delete this computer's key on the Instance. --all logs out everywhere." },
    ],
  },
  {
    id: 'folder',
    name: 'This folder',
    commands: [
      { cmd: 'cloudgate deploy', text: 'Upload what changed in this folder and deploy it, then follow the Deployment log until it ends. --full uploads every file.' },
      { cmd: 'cloudgate status', text: 'Show the Service, whether it is running, its Domains and its latest Deployment.' },
      { cmd: 'cloudgate logs', text: "Show the Service's last 100 log lines; -f keeps following, --deployment shows a build log." },
      { cmd: 'cloudgate vars list | set | unset', text: "List, set and unset the Service's variables. Values are never printed." },
      { cmd: 'cloudgate link', text: 'Link this folder to a Service, so later commands know where to go.' },
      { cmd: 'cloudgate unlink', text: "Remove this folder's link. Nothing changes on the Instance." },
    ],
  },
  {
    id: 'project',
    name: 'A Project folder',
    commands: [
      { cmd: 'cloudgate link --whole-project', text: "Link this folder to a whole Project and save its config here as cloudgate.yaml." },
      { cmd: 'cloudgate config pull', text: "Replace this folder's cloudgate.yaml with the Project config as Cloudgate holds it." },
      { cmd: 'cloudgate config plan', text: 'Show what your cloudgate.yaml would create, change and destroy, and apply it on a yes.' },
      { cmd: 'cloudgate deploy', text: 'At the root: plan, then build every app the config builds from a subfolder.' },
    ],
  },
  {
    id: 'templates',
    name: 'Templates',
    commands: [
      { cmd: 'cloudgate template try <folder>', text: "Start a template's compose part on this computer's Docker, check each Domain answers, then remove it all. Values come from test-values.yaml." },
      { cmd: 'cloudgate template check <path>', text: 'Check templates as Cloudgate will read them, without any request.' },
      { cmd: 'cloudgate template pack <folder> <out>', text: 'Build the catalogue.zip a templates release publishes.' },
    ],
  },
];
const [loginGroup, folderGroup, projectGroup, templatesGroup] = commandGroups;

// The drawn folder in "What does cloudgate deploy upload?".
const tree = [
  { path: 'src/', state: 'up', why: 'Uploaded' },
  { path: 'package.json', state: 'up', why: 'Uploaded' },
  { path: 'notes.md', state: 'up', why: 'Uploaded, not committed yet' },
  { path: 'node_modules/', state: 'ignored', why: 'Listed in .gitignore' },
  { path: 'dist/', state: 'ignored', why: 'Listed in .cloudgateignore' },
  { path: '.env', state: 'never', why: 'Always left out' },
  { path: '.env.example', state: 'up', why: 'Uploaded' },
  { path: '.git/', state: 'never', why: 'Always left out' },
  { path: '.cloudgate/', state: 'never', why: 'Always left out' },
  { path: 'shared → ../lib', state: 'warn', why: 'Symlink, skipped with a warning' },
];

const faq = [
  {
    q: 'Which version of Node does the Cloudgate CLI need?',
    a: 'Node 22 or newer. The command refuses to start on an older Node and says so.',
  },
  {
    q: 'Does cloudgate deploy upload my .env file?',
    a: 'No. .env and .env.* files are left out (except .env.example), and so is anything your .gitignore or a .cloudgateignore lists. Put secrets in with <code>cloudgate vars set KEY</code>, which asks for the value without showing it.',
  },
  {
    q: 'Can I use the CLI with a self-hosted Cloudgate?',
    a: 'Yes. Run <code>cloudgate login --instance your-console-address</code>. The CLI can be logged in to several Instances at once; <code>cloudgate instance use</code> switches between them. See <a href="/self-hosted">how to self-host Cloudgate</a>.',
  },
  {
    q: 'Does the CLI create the app for me?',
    a: 'It can create the Project. A first <code>cloudgate deploy</code> in a folder with no link offers Create a new Project: it asks the name and where its apps run (a ready Server, or a Cloud account and region), makes the Project with a <code>production</code> Environment, and saves a starter <code>cloudgate.yaml</code> in the folder. Add your apps there and run <code>cloudgate deploy</code> again. To deploy one app into an existing Project, make the Application in the console first.',
  },
  {
    q: 'Does cloudgate deploy upload the whole folder every time?',
    a: 'No. From version 0.0.2-beta.3 it uploads only the files that are new or changed since the last upload, and deletes on the Instance the files you deleted. Run <code>cloudgate deploy --full</code> to send every file. An Instance older than 0.2.0 always gets the full upload.',
  },
  {
    q: 'How do I deploy from CI without logging in?',
    a: 'Make a Personal key in the console, store it as a secret, and set <code>CLOUDGATE_KEY</code> in the job. Name the target with CLOUDGATE_ORG, CLOUDGATE_PROJECT, CLOUDGATE_ENV and CLOUDGATE_SERVICE, since a CI job cannot answer questions.',
  },
];

const howTo = {
  '@type': 'HowTo',
  name: 'Deploy a folder with the Cloudgate CLI',
  description: 'Install the Cloudgate CLI, log in, and deploy the current folder to an Application on Cloudgate.',
  tool: [{ '@type': 'HowToTool', name: 'Node.js 22 or newer' }],
  step: [
    {
      '@type': 'HowToStep',
      name: 'Install the CLI',
      text: 'Run: npm install -g @octabyte-io/cloudgate@next (the beta; the latest tag is still a placeholder).',
    },
    {
      '@type': 'HowToStep',
      name: 'Log in',
      text: 'Run: cloudgate login. Open the link it prints, check the code and approve it in the Cloudgate console.',
    },
    {
      '@type': 'HowToStep',
      name: 'Deploy the folder',
      text: 'In your project folder, run: cloudgate deploy. Pick the Organization, Project, Environment and Service the first time; the CLI uploads the folder and follows the Deployment log until it ends.',
    },
    {
      '@type': 'HowToStep',
      name: 'Check it',
      text: 'Run: cloudgate status to see whether the Service is running and its Domains, and cloudgate logs to read its output.',
    },
  ],
};

const title = 'Cloudgate CLI: deploy any folder from your terminal';
const description =
  'Install the Cloudgate CLI from npm, log in with a code you approve in the console, and deploy the current folder. Also status, logs, variables and CI keys.';
---

<Base title={title} description={description} schema={[howTo, faqSchema(faq), breadcrumbSchema(trail)]}>
  <PageHero
    title="Cloudgate CLI: deploy a folder from your terminal"
    lede="Run one command in your project folder and Cloudgate uploads it, builds it and follows the build log until it is live. The same commands work in a CI job with a key."
    trail={trail}
  >
    <a class="btn btn--primary" href="#install">Install the CLI</a>
    <a class="btn btn--ghost" href={site.npm}>View on npm</a>
    <div class="window term" slot="visual" aria-label="A deploy from the terminal" role="img">
      <div class="window-bar">~/my-app</div>
      <pre class="code" data-play style="--type-step:160ms"><code><span class="ln" style="--i:0"><span class="d">$</span> <span class="k">npm</span> install -g @octabyte-io/cloudgate@next</span>
<span class="ln" style="--i:1"><span class="d">$</span> <span class="k">cloudgate</span> login</span>
<span class="ln" style="--i:2"><span class="d">  Approve code</span> <span class="s">QXRT-7PLM</span> <span class="d">in the console</span></span>
<span class="ln" style="--i:3"><span class="d">$</span> <span class="k">cd</span> my-app</span>
<span class="ln" style="--i:4"><span class="d"># uploads this folder, builds it, follows the log</span></span>
<span class="ln" style="--i:5"><span class="d">$</span> <span class="k">cloudgate</span> deploy</span>
<span class="ln" style="--i:6"><span class="d">  Uploading 214 files (skipping .env and .git)</span></span>
<span class="ln" style="--i:7"><span class="d">  Building with Nixpacks</span></span>
<span class="ln" style="--i:8"><span class="d">  Deployment</span> <span class="s">done</span></span>
<span class="ln" style="--i:9"><span class="d"># running? which address? which Deployment?</span></span>
<span class="ln" style="--i:10"><span class="d">$</span> <span class="k">cloudgate</span> status</span>
<span class="ln" style="--i:11"><span class="d">  web</span>  <span class="s">running</span>  <span class="d">shop.example.com</span></span></code></pre>
    </div>
  </PageHero>

  <section class="early-strip" aria-label="Release status">
    <div class="wrap">
      <p class="note note--warn early">
        <strong>The CLI is a beta.</strong> The current release, 0.0.2-beta.3, is on npm's
        {" "}<code>next</code> tag: <code>npm install -g @octabyte-io/cloudgate@next</code>. The
        {" "}<code>latest</code> tag (0.0.1) is a placeholder. Commands and flags may still change
        before 1.0; each beta is listed in the <a href="/changelog">Cloudgate changelog</a>, and the
        CLI's source is in <a href={`${site.sourceUrl}/tree/main/cli`}>the Cloudgate repository</a>.
      </p>
    </div>
  </section>

  <section class="section" id="install" aria-labelledby="install-title">
    <div class="wrap split install">
      <div class="section-head sticky-head" data-reveal>
        <h2 id="install-title">How do you deploy a folder with the Cloudgate CLI?</h2>
        <p class="lede">
          Four steps. You need Node 22 or newer and a Cloudgate account. Deploy into an Application
          made in the console, or let the first deploy make a <a href="#project-folders">new
          Project</a>.
        </p>
      </div>
      <ol class="steps" data-reveal-stagger="80">
        <li>
          <h3>Install it from npm</h3>
          <p>
            The package is <code>@octabyte-io/cloudgate</code>; the command it installs is
            {" "}<code>cloudgate</code>. Install the beta from the <code>next</code> tag: the
            {" "}<code>latest</code> tag still holds a placeholder.
          </p>
          <pre class="code"><code><span class="k">npm</span> install -g @octabyte-io/cloudgate@next</code></pre>
        </li>
        <li>
          <h3>Log in through your browser</h3>
          <p>
            The CLI prints a link and a code. Open the link on any device, check the code matches
            and approve it in the console. This computer then gets a Personal key that ends in 90
            days, kept in the system keychain. For a self-hosted Cloudgate, give its address.
          </p>
          <pre class="code"><code><span class="k">cloudgate</span> login
<span class="k">cloudgate</span> login --instance <span class="s">cloud.example.com</span>   <span class="d"># a self-hosted console</span></code></pre>
        </li>
        <li>
          <h3>Deploy the current folder</h3>
          <p>
            The first time, it asks which Project the folder belongs to (or makes a new one), then
            whether it is one app or the whole Project, and saves that link in
            {" "}<code>.cloudgate/</code> (added to your <code>.gitignore</code>). It waits for any
            build already running, uploads, then follows the Deployment log and exits 0 only if the
            Deployment is done.
          </p>
          <pre class="code"><code><span class="k">cloudgate</span> deploy
<span class="k">cloudgate</span> deploy --env <span class="s">production</span>   <span class="d"># the same Service in another Environment</span></code></pre>
        </li>
        <li>
          <h3>Check it is running</h3>
          <p>Status shows whether it runs, its Domains and its latest Deployment. Logs prints what it writes.</p>
          <pre class="code"><code><span class="k">cloudgate</span> status
<span class="k">cloudgate</span> logs -f</code></pre>
        </li>
      </ol>
    </div>
  </section>

  <section class="section band" aria-labelledby="upload-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="upload-title">What does cloudgate deploy upload?</h2>
        <p class="lede">
          The folder as it is on your disk, uncommitted changes included, minus anything that
          should not leave your machine.
        </p>
      </div>
      <div class="upload" data-reveal>
        <figure class="tree panel" aria-hidden="true">
          <figcaption>my-app/</figcaption>
          <ul>
            {tree.map((t) => (
              <li class={`t-${t.state}`}>
                <span class="t-path">{t.path}</span>
                <span class="t-why">{t.why}</span>
              </li>
            ))}
          </ul>
        </figure>
        <dl class="upload-facts">
          <div class="f-up">
            <dt>Uploaded</dt>
            <dd>Every file in the linked folder, or the current folder when nothing is linked yet, whether committed or not.</dd>
          </div>
          <div class="f-ignored">
            <dt>Left out by your ignore files</dt>
            <dd>
              Anything any <code>.gitignore</code> or a <code>.cloudgateignore</code> lists. Both use
              the same syntax, and <code>!</code> brings a file back.
            </dd>
          </div>
          <div class="f-never">
            <dt>Always left out</dt>
            <dd>
              <code>.git</code>, <code>.cloudgate</code>, and <code>.env</code> files except
              {" "}<code>.env.example</code>. Put secrets in with <code>cloudgate vars set KEY</code>.
            </dd>
          </div>
          <div class="f-delta">
            <dt>Only what changed, after the first time</dt>
            <dd>
              Each deploy compares the folder with the Instance file by file (SHA-256) and uploads
              only new and changed files; files you deleted are deleted there too.
              {" "}<code>--full</code> sends every file. This needs an Instance at version 0.2.0 or
              newer; an older one simply gets the full upload.
            </dd>
          </div>
          <div class="f-warn">
            <dt>Warned about</dt>
            <dd>Symlinks are skipped with a warning, and an upload whose zip is over 100 MB names its biggest folders before it goes.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="project-folders" aria-labelledby="project-title">
    <div class="wrap">
      <div class="project">
        <div class="project-text">
          <div class="section-head" data-reveal>
            <h2 id="project-title">How do you deploy a whole Project from one folder?</h2>
            <p class="lede">
              Make the folder a Project folder, usually a monorepo's root. Its
              {" "}<code>cloudgate.yaml</code> describes every app, and one <code>cloudgate deploy</code>
              {" "}plans the change, then builds each app from its own subfolder. New in 0.0.2-beta.3.
            </p>
          </div>
          <ol class="steps" data-reveal-stagger="80">
            <li>
              <h3>Link the whole Project</h3>
              <p>It asks for the Organization, Project and Environment, never a Service, and saves the Project config here as your working copy.</p>
              <pre class="code"><code><span class="k">cloudgate</span> link --whole-project</code></pre>
            </li>
            <li>
              <h3>Edit cloudgate.yaml</h3>
              <p>Give each app a subfolder as its source. <code>cloudgate config pull</code> fetches the current config again when a teammate has changed it.</p>
            </li>
            <li>
              <h3>Plan, then deploy</h3>
              <p>
                You see what each Environment's Plan creates, changes and destroys, and it applies on
                a yes. Destroying a Service asks you to type its Config name. Then every app built from a
                subfolder is uploaded, built and followed to its end.
              </p>
              <pre class="code"><code><span class="k">cloudgate</span> config plan   <span class="d"># the plan alone</span>
<span class="k">cloudgate</span> deploy        <span class="d"># the plan, then every app</span></code></pre>
            </li>
          </ol>
        </div>
        <div class="window project-win" data-reveal data-reveal-delay="120">
          <div class="window-bar">~/shop</div>
          <div class="project-tree" aria-label="A Project folder" role="img">
            <ul>
              <li class="pt-dir">shop/</li>
              <li class="pt-key">cloudgate.yaml</li>
              <li class="pt-dir pt-in">apps/web/</li>
              <li class="pt-dir pt-in">apps/api/</li>
              <li class="pt-dim">.cloudgate/</li>
            </ul>
          </div>
          <pre class="code"><code><span class="d"># Cloudgate keeps this Project's config;</span>
<span class="d"># this file is your working copy.</span>
<span class="k">version</span>: <span class="s">1</span>
<span class="k">services</span>:
  <span class="k">web</span>:
    <span class="k">kind</span>: <span class="s">web</span>
    <span class="k">source</span>: {'{'} <span class="k">folder</span>: <span class="s">apps/web</span> {'}'}
  <span class="k">api</span>:
    <span class="k">kind</span>: <span class="s">web</span>
    <span class="k">source</span>: {'{'} <span class="k">folder</span>: <span class="s">apps/api</span> {'}'}</code></pre>
        </div>
      </div>
      <dl class="project-facts" data-reveal-stagger>
        <div>
          <dt>A first deploy asks</dt>
          <dd>In a folder with no link, <code>cloudgate deploy</code> asks which Project, or offers to create one, then whether this is one app or the whole Project.</dd>
        </div>
        <div>
          <dt>Edits never cross</dt>
          <dd>If the Project config has moved on since your copy, the plan is refused and nothing is sent; <code>config pull</code> brings your copy up to date.</dd>
        </div>
        <div>
          <dt>Only apps from a subfolder are built</dt>
          <dd>Apps from a repository or an image, databases and buckets are listed as skipped. <code>--service</code> deploys one app only.</dd>
        </div>
        <div>
          <dt>Safe without a terminal</dt>
          <dd>In CI, <code>--yes</code> applies a plan, but still refuses one that destroys a Service or makes a major upgrade.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section band" id="commands" aria-labelledby="commands-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="commands-title">Which commands does the CLI have?</h2>
        <p class="lede">
          Every command explains itself with <code>--help</code>. Several take <code>--json</code> for
          scripts, and every one that acts on a Service takes <code>--org</code>,
          {" "}<code>--project</code>, <code>--env</code> and <code>--service</code>.
        </p>
      </div>
      <div class="groups" data-reveal-stagger>
        <div data-spotlight class="group g-folder">
          <div class="art" aria-hidden="true">
            <pre class="mini"><code><span class="p">$</span> cloudgate status
<span class="dim">Service</span>      web
<span class="dim">State</span>        <span class="ok">running</span>
<span class="dim">Domains</span>      shop.example.com
<span class="dim">Deployment</span>   done</code></pre>
          </div>
          <h3>{folderGroup.name}</h3>
          <dl class="cmds cmds--two">
            {folderGroup.commands.map((c) => (
              <div>
                <dt><code>{c.cmd}</code></dt>
                <dd>{c.text}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div data-spotlight class="group g-login">
          <div class="art" aria-hidden="true">
            <pre class="mini"><code><span class="p">$</span> cloudgate instance list
<span class="ok">*</span> cloudgate.octabyte.app
  cloud.example.com</code></pre>
          </div>
          <h3>{loginGroup.name}</h3>
          <dl class="cmds">
            {loginGroup.commands.map((c) => (
              <div>
                <dt><code>{c.cmd}</code></dt>
                <dd>{c.text}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div data-spotlight class="group g-project">
          <h3>{projectGroup.name}</h3>
          <dl class="cmds cmds--four">
            {projectGroup.commands.map((c) => (
              <div>
                <dt><code>{c.cmd}</code></dt>
                <dd>{c.text}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div data-spotlight class="group g-templates">
          <div class="art pack" aria-hidden="true">
            <span class="node">templates/</span>
            <span class="wire"></span>
            <span class="node node--gate">template pack</span>
            <span class="wire"></span>
            <span class="node">catalogue.zip</span>
          </div>
          <div class="g-body">
            <h3>{templatesGroup.name}</h3>
            <dl class="cmds cmds--two">
              {templatesGroup.commands.map((c) => (
                <div>
                  <dt><code>{c.cmd}</code></dt>
                  <dd>{c.text}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ci-title">
    <div class="wrap split ci">
      <div class="prose" data-reveal>
        <h2 id="ci-title">How do you deploy from CI?</h2>
        <p class="lede">
          Use a Personal key instead of logging in. Make one in the console, store it as a secret
          in your CI, and set it as <code>CLOUDGATE_KEY</code>.
        </p>
        <p>
          A CI job cannot answer questions, so name the target with variables or flags. Add
          {" "}<code>--switch-source</code> if the Service used to deploy from git or an image, and
          {" "}<code>--detach --json</code> to queue the Deployment and move on. A key from
          {" "}<code>CLOUDGATE_KEY</code> is never written to disk.
        </p>
      </div>
      <div class="window ci-win" data-reveal data-reveal-delay="120">
        <div class="window-bar ci-tabs" role="radiogroup" aria-label="CI example">
          <input type="radio" name="ci" id="ci-gh" checked />
          <label for="ci-gh"><span class="path-dir">.github/workflows/</span>deploy.yml</label>
          <input type="radio" name="ci" id="ci-sh" />
          <label for="ci-sh">Any CI job</label>
        </div>
        <pre class="code pane pane--gh" tabindex="0" aria-label="GitHub Actions workflow"><code><span class="k">name</span>: Deploy
<span class="k">on</span>:
  <span class="k">push</span>:
    <span class="k">branches</span>: [<span class="s">main</span>]
<span class="k">jobs</span>:
  <span class="k">deploy</span>:
    <span class="k">runs-on</span>: ubuntu-latest
    <span class="k">steps</span>:
      - <span class="k">uses</span>: actions/checkout@v4
      - <span class="k">uses</span>: actions/setup-node@v4
        <span class="k">with</span>:
          <span class="k">node-version</span>: <span class="s">22</span>
      - <span class="k">run</span>: npm install -g @octabyte-io/cloudgate@next
      - <span class="k">run</span>: cloudgate deploy
        <span class="k">env</span>:
          <span class="k">CLOUDGATE_KEY</span>: <span class="s">{'${{ secrets.CLOUDGATE_KEY }}'}</span>
          <span class="k">CLOUDGATE_PROJECT</span>: <span class="s">shop</span>
          <span class="k">CLOUDGATE_ENV</span>: <span class="s">production</span>
          <span class="k">CLOUDGATE_SERVICE</span>: <span class="s">web</span></code></pre>
        <pre class="code pane pane--sh" tabindex="0" aria-label="Shell CI job"><code><span class="d"># in your CI job</span>
<span class="s">export</span> CLOUDGATE_KEY=<span class="d">&lt;Personal key from your secrets&gt;</span>
<span class="s">export</span> CLOUDGATE_PROJECT=<span class="s">shop</span>
<span class="s">export</span> CLOUDGATE_ENV=<span class="s">production</span>
<span class="s">export</span> CLOUDGATE_SERVICE=<span class="s">web</span>

<span class="k">npm</span> install -g @octabyte-io/cloudgate@next
<span class="k">cloudgate</span> deploy --switch-source</code></pre>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="other-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="other-title">Not working in a terminal?</h2>
