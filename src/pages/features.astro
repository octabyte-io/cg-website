<style>
  /* ---- Windows ---- */
  .window.ui {
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(180deg, var(--line-strong), var(--line)) border-box;
  }
  .window.term .window-bar {
    border-bottom-color: var(--night-line);
    color: var(--night-muted);
  }
  .window.term .window-bar::before {
    background: var(--night-line);
    box-shadow:
      1rem 0 0 var(--night-line),
      2rem 0 0 var(--night-line);
  }
  .window.term .code {
    border: 0;
    border-radius: 0;
    background: transparent;
    font-size: var(--text-xs);
    white-space: pre-wrap;
  }
  .window-bar {
    white-space: nowrap;
  }

  /* ---- Hero map: ways in, the gate, where it runs ---- */
  .hero-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem auto 2.5rem minmax(0, 1fr);
    align-items: start;
    padding: var(--space-5);
  }
  .hm-col {
    display: grid;
    gap: var(--space-3);
  }
  .hm-label {
    height: 1.5rem;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .hm-node {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 3rem;
    padding: 0 var(--space-3);
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .hm-wires {
    width: 100%;
    height: 11.25rem;
  }
  .hm-wires path {
    fill: none;
    stroke-width: 2;
    stroke-dasharray: 5 6;
    vector-effect: non-scaling-stroke;
  }
  .w1 {
    stroke: var(--slice-1);
  }
  .w2 {
    stroke: var(--slice-2);
  }
  .w3 {
    stroke: var(--slice-3);
  }
  /* The map at work: one deploy at a time comes in by one way, passes the gate and goes out to a
     place, and the next one pairs them differently (console to AWS, agent to Google Cloud,
     terminal to your Server), so it reads as "any way in, any place". 7.2s for the three routes,
     2.4s each; every piece is hidden at both 0% and 100%, so the loop has no seam. */
  .hm-pk {
    fill: none;
    stroke: var(--brand-hi);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 22 200;
    stroke-dashoffset: 22;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .hm-node {
    position: relative;
  }
  .hm-node::after,
  .hm-gate::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--brand);
    box-shadow: 0 0 22px -6px var(--glow);
    opacity: 0;
    pointer-events: none;
  }
  .hm-gate {
    position: relative;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-map.is-playing .hm-pk {
      animation: hm-pk 7.2s var(--ease-in-out) infinite both;
    }
    .hero-map.is-playing .hm-node::after {
      animation: hm-node 7.2s var(--ease-out) infinite both;
    }
    .hero-map.is-playing .hm-gate::after {
      animation: hm-gate 2.4s var(--ease-out) infinite both;
      animation-delay: 0.75s;
    }
    /* In: route k leaves its way in at k x 2.4s. Out: the gate sends it on 0.8s later, to the
       next place down (wrapping round). */
    .hero-map.is-playing .hm-left .hm-pk:nth-of-type(5),
    .hero-map.is-playing .hm-in .hm-node:nth-of-type(2)::after {
      animation-delay: 2.4s;
    }
    .hero-map.is-playing .hm-left .hm-pk:nth-of-type(6),
    .hero-map.is-playing .hm-in .hm-node:nth-of-type(3)::after {
      animation-delay: 4.8s;
    }
    .hero-map.is-playing .hm-right .hm-pk:nth-of-type(5) {
      animation-delay: 0.8s;
    }
    .hero-map.is-playing .hm-right .hm-pk:nth-of-type(6) {
      animation-delay: 3.2s;
    }
    .hero-map.is-playing .hm-right .hm-pk:nth-of-type(4) {
      animation-delay: 5.6s;
    }
    .hero-map.is-playing .hm-out .hm-node:nth-of-type(2)::after {
      animation-delay: 1.4s;
    }
    .hero-map.is-playing .hm-out .hm-node:nth-of-type(3)::after {
      animation-delay: 3.8s;
    }
    .hero-map.is-playing .hm-out .hm-node:nth-of-type(1)::after {
      animation-delay: 6.2s;
    }
  }
  @keyframes hm-pk {
    0% {
      stroke-dashoffset: 22;
      opacity: 0;
    }
    1.5% {
      opacity: 1;
    }
    9% {
      opacity: 1;
    }
    11%,
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }
  @keyframes hm-node {
    0% {
      opacity: 0;
    }
    3%,
    14% {
      opacity: 1;
    }
    24%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hm-gate {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    40%,
    100% {
      opacity: 0;
    }
  }
