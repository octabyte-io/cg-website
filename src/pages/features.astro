<span class="ln" style="--i:1"><span class="k">DATABASE_URL</span>   <span class="s">pg-1.url</span>  <span class="d">wired</span></span>
<span class="ln" style="--i:2"><span class="k">STRIPE_KEY</span>     <span class="d">set, hidden</span></span></pre>
