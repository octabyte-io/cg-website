---
import { templatesHome } from '../data/template-links';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, plans, trialDays } from '../data/site';
import { faqSchema, breadcrumbSchema, howToSchema } from '../data/schema';

const trail = [{ name: 'Vibe coding', path: '/vibe-coding' }];

const title = 'Put your AI-built app online in three steps | Cloudgate';
const description =
  'Built an app with Lovable, Bolt, Cursor or Claude? Put it online without learning servers: sign up, get a server, press Deploy and share the address you get.';

const starter = plans.find((p) => p.id === 'starter')!;

const steps = [
  {
    h: 'Sign up',
    p: `Make an account on Cloudgate. The ${trialDays}-day free trial needs a card to start.`,
  },
  {
    h: 'Get a server',
    p: 'Buy one from us in the console: pick a place on the map and a size, and see the price before you pay. Or use a server you already have: Cloudgate makes a key and gives you one command to paste into it.',
  },
  {
    h: 'Press Deploy',
    p: 'Cloudgate sets the server up by itself once it is ready, then builds your app and starts it. You watch it happen; there is nothing to type.',
  },
];

const looked = [
  {
    t: 'The padlock in the browser',
    d: 'Add your own domain and Cloudgate gets the https certificate for it and renews it. You never touch a certificate file.',
  },
  {
    t: 'A database that is set up for you',
    d: 'PostgreSQL, MySQL, MariaDB, MongoDB, Redis or libSQL, next to your app. Cloudgate links its address into your app, so you do not paste passwords around.',
  },
  {
    t: 'Backups',
    d: 'Copies of your databases and stored files, sent to storage you choose, so a mistake is not the end of your data.',
  },
  {
    t: 'An undo button for updates',
    d: 'If a change breaks your app, roll back to an earlier Deployment, the version that worked, while the change gets fixed.',
  },
  {
    t: 'Logs you can read',
    d: 'When something goes wrong, the build log and your app\'s own log are in the console, a click away from the app.',
  },
  {
    t: 'Someone watching it',
    d: 'Uptime checks visit your app, and Cloudgate tells you on Slack, Discord, Telegram, email and more when it stops answering.',
  },
];

const faq = [
  {
    q: 'Do I need to know about servers to use Cloudgate?',
    a: 'No. The get started path sets the server up for you: buy one in the console, or paste one command into a server you already have. Cloudgate installs what it needs and then deploys your app.',
  },
  {
    q: 'I built my app with Lovable, Bolt, v0 or Replit. Will it work?',
    a: 'If your app\'s code is in a folder or a GitHub repository, Cloudgate can build it. It works out how to build most apps on its own, and it can also use a Dockerfile if your project has one. Cloudgate does not connect to those tools directly; it works from the code they give you.',
  },
  {
    q: 'What address does my app get?',
    a: 'Right away, a free address ending in <code>sslip.io</code> that works over plain http. For https and a name people remember, add your own domain and Cloudgate gets the certificate for it.',
  },
  {
    q: 'What if an update breaks my app?',
    a: 'Roll back to an earlier Deployment from the console. The version that worked comes back while you, or your AI tool, fix the change.',
  },
  {
    q: 'How much does it cost?',
    a: `Your plan plus your server. The Starter plan is $${starter.price} a month on the Hosted instance, after a ${trialDays}-day free trial. A server you buy from us is billed on top at the price shown before you buy; your own server costs whatever your provider charges. See <a href="/pricing">Cloudgate pricing</a>.`,
  },
  {
    q: 'Can my AI tool deploy for me?',
    a: 'Yes. Give it its own Agent in Cloudgate and connect it over MCP. It can deploy, read the logs and check your app is up, and it never sees your stored secrets. See <a href="/ai-agents">Cloudgate for AI agents</a>.',
  },
];
---
<Base title={title} description={description} schema={[
  howToSchema({
    name: 'Put an app you built with AI online with Cloudgate',
    description: 'Three steps in the Cloudgate console: sign up, get a server, press Deploy.',
    steps: steps.map((s) => ({ name: s.h, text: s.p, url: `${site.url}/vibe-coding#how` })),
  }),
  faqSchema(faq),
  breadcrumbSchema(trail),
]}>
  <PageHero
    title="Put the app you built with AI online"
    lede="You made something with Lovable, Bolt, Cursor, Claude, v0 or Replit, and now it needs a home on the internet. Cloudgate gives it one, on a server that is yours, with an address you can send to people. No server knowledge needed."
    trail={trail}
  >
    <a class="btn btn--primary" href={site.getStarted}>Get started</a>
    <a class="btn btn--ghost" href={templatesHome}>Browse ready-made apps</a>
    <div slot="visual" class="hero-visual" aria-hidden="true">
      <div class="window browser">
        <div class="window-bar"><span class="url">notes-app.203.0.113.10.sslip.io</span></div>
        <div class="browser-body">
          <div class="live-pill"><span class="live">Running</span><span>Deployed 40 seconds ago</span></div>
          <div class="fake-app">
            <div class="fa-side">
              <span class="fa-logo"></span>
              <span class="fa-item on"></span>
              <span class="fa-item"></span>
              <span class="fa-item"></span>
              <span class="fa-item short"></span>
            </div>
            <div class="fa-main">
              <span class="fa-title"></span>
              <span class="fa-line"></span>
              <span class="fa-line"></span>
              <span class="fa-line short"></span>
              <div class="fa-cards"><span></span><span></span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="toast">
        <span class="tick"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3.5 8.5l3 3 6-7" pathLength="1" /></svg></span>
        <span><strong>Your app is live</strong><small>Send the address to anyone</small></span>
      </div>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="how">
    <div class="wrap how">
      <div>
        <div class="section-head" data-reveal>
          <h2 id="how">How do I get my app online?</h2>
          <p class="lede">Three steps in the console. Most of the waiting is the server being set up, and Cloudgate does that part.</p>
        </div>
        <ol class="steps" data-reveal-stagger="80">
          {steps.map((s) => (
            <li>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </li>
          ))}
        </ol>
      </div>

      <figure class="done" aria-labelledby="done-cap" data-reveal data-reveal-delay="120">
        <div class="window ui wizard">
          <div class="window-bar">Get started</div>
          <div class="wiz-body">
            <ol class="wiz" aria-hidden="true">
              <li class="ok"><span>Your account</span><span>Signed in</span></li>
              <li class="ok"><span>A server</span><span>Ready</span></li>
              <li class="ok cur"><span>Deploy</span><span class="live">Done</span></li>
            </ol>
            <div class="mock">
              <p class="live">Running</p>
              <p class="app-name">notes-app</p>
              <p class="addr"><code>http://notes-app.203.0.113.10.sslip.io</code></p>
              <span class="btn btn--primary fake-btn" aria-hidden="true">Open notes-app</span>
              <p class="hint">Add your own domain for https</p>
            </div>
          </div>
        </div>
        <figcaption id="done-cap">
          What you see at the end: your app's address and a button to open it. The free <code>sslip.io</code> address works right away over plain http. Add your own domain and
          it gets https, the padlock in the browser.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section band" aria-labelledby="routes">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="routes">Which way should I deploy my app?</h2>
        <p class="lede">Pick a ready-made app if you want one that already exists. Bring your own if your AI tool made it.</p>
      </div>
      <div class="routes" data-reveal-stagger="80">
        <article class="route" data-spotlight>
          <div class="art logos" aria-hidden="true">
            {['wordpress', 'ghost', 'n8n', 'nextcloud', 'uptime-kuma'].map((id) => (
              <span class="logo"><img src={`/templates/${id}.svg`} alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
            ))}
            <span class="logo more-logo">and more</span>
          </div>
          <h3><span class="slice" aria-hidden="true"></span>Start from a ready-made app</h3>
          <p>
            Popular apps people run for themselves, such as WordPress, Ghost, n8n, Nextcloud,
            Umami and Uptime Kuma. Pick one, press Deploy, and the get started steps above take
            you the rest of the way.
          </p>
          <p><a class="text-link" href={templatesHome}>See all app templates</a></p>
        </article>

        <article class="route" data-spotlight>
          <h3><span class="slice slice--2" aria-hidden="true"></span>Deploy the app your AI made</h3>
          <div class="way">
            <div class="push art" aria-hidden="true">
              <span class="node">GitHub repository</span>
              <span class="wire"><span>push</span></span>
              <span class="node gate">Cloudgate</span>
              <span class="wire"><span>deploys</span></span>
              <span class="node"><span class="live">New version</span></span>
            </div>
            <p>
              <strong>From GitHub.</strong> Many AI app builders can save your project to GitHub.
              Connect that repository in the console, and every time a change is pushed to it,
              Cloudgate deploys the new version.
            </p>
          </div>
          <div class="way">
            <p>
              <strong>From a folder on your computer.</strong> If you have the project folder,
              three commands in a terminal send it up. Cloudgate skips your <code>.env</code> file
              and anything in <code>.gitignore</code>.
            </p>
            <div class="window term">
              <div class="window-bar">Terminal, in your app's folder</div>
              <pre class="code" data-play style="--type-step:260ms"><span class="ln" style="--i:0"><span class="d"># once</span></span>
<span class="ln" style="--i:1">npm install -g @octabyte-io/cloudgate</span>
<span class="ln" style="--i:2">cloudgate login</span>
<span class="ln" style="--i:3"><span class="d"># from your app's folder</span></span>
<span class="ln" style="--i:4">cloudgate deploy</span></pre>
            </div>
          </div>
          <p class="small">
            The command line tool is new and needs Node 22 or newer. <a href="/cli">How the Cloudgate CLI works</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="looked">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="looked">What does Cloudgate look after for me?</h2>
        <p class="lede">
          The parts of running an app that people usually learn the hard way. You get them without
          having to know their names.
        </p>
      </div>
      <dl class="bento" data-reveal-stagger>
        {looked.map((f, i) => (
          <div class:list={['tile', `t${i}`]} data-spotlight>
            <div class="art" aria-hidden="true">
              {i === 0 && (
                <>
                  <div class="urlbar">
                    <svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M4.5 7V5.2a3.5 3.5 0 1 1 7 0V7h.8c.4 0 .7.3.7.7v6.6c0 .4-.3.7-.7.7H3.7a.7.7 0 0 1-.7-.7V7.7c0-.4.3-.7.7-.7h.8Zm1.6 0h3.8V5.2a1.9 1.9 0 1 0-3.8 0V7Z" /></svg>
                    <span>https://mynotes.example.com</span>
                  </div>
                  <p class="tag live">Certificate issued, renews by itself</p>
                </>
              )}
              {i === 1 && (
                <div class="wired">
                  <span class="node">notes-app</span>
                  <span class="wire"><span>DATABASE_URL</span></span>
                  <span class="node db">PostgreSQL</span>
                </div>
              )}
              {i === 2 && (
                <>
                  <ol class="timeline"><li></li><li></li><li></li><li></li><li class="now"></li></ol>
                  <p class="tag">Last copy taken tonight, sent to your storage</p>
                </>
              )}
              {i === 3 && (
                <ul class="deploys">
                  <li class="bad"><span>Today, 14:10</span><span>Broken</span></li>
                  <li class="good"><span>Yesterday, 09:32</span><span class="roll">Roll back</span></li>
                </ul>
              )}
              {i === 4 && (
                <pre class="log"><span class="d">14:10:02</span> GET /notes 200
<span class="d">14:10:05</span> GET /notes/7 200
<span class="d">14:10:09</span> <span class="w">POST /notes 500</span></pre>
              )}
              {i === 5 && (
                <div class="alert">
                  <span class="alert-dot"></span>
                  <span><strong>notes-app is not answering</strong><small>Uptime check failed. Sent to Slack and email.</small></span>
                </div>
              )}
            </div>
            <dt>{f.t}</dt>
            <dd>{f.d}</dd>
          </div>
        ))}
      </dl>
      <p class="more"><a class="text-link" href="/features">Everything Cloudgate does, in detail</a></p>
    </div>
  </section>

  <section class="section band" aria-labelledby="ai">
    <div class="wrap split ai">
      <div class="stack" data-reveal>
        <h2 id="ai">Can my AI do the deploying too?</h2>
        <div class="prose">
          <p>
            Yes. If you build with Claude Code, Cursor or another tool that speaks MCP, give it its
            own Agent in Cloudgate. Then you can ask it to ship a fix, and it deploys, reads the log
            and checks that your app is up before it tells you it is done.
          </p>
          <p>
            It only reaches the apps you allow, it never sees your passwords, and everything it does
            is written down for you to read later.
          </p>
          <p><a class="text-link" href="/ai-agents">Let your AI tool deploy with Cloudgate</a></p>
        </div>
      </div>
      <div class="panel chat" aria-hidden="true" data-reveal data-reveal-delay="120" data-play style="--type-step:450ms">
        <p class="msg you ln" style="--i:0">The save button is broken. Fix it and put it online.</p>
        <p class="msg bot ln" style="--i:1">Fixed it and asked Cloudgate to deploy.</p>
        <ul class="calls">
          <li class="ln" style="--i:2"><code>deploy_service</code><span class="live">Done</span></li>
          <li class="ln" style="--i:3"><code>read_deployment_log</code><span>Build finished, <code>DATABASE_URL=••••••</code></span></li>
          <li class="ln" style="--i:4"><code>get_service_health</code><span class="live">Up</span></li>
        </ul>
        <p class="msg bot ln" style="--i:5">It is live and your app is answering.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cost">
    <div class="wrap split cost">
      <div class="stack" data-reveal>
        <h2 id="cost">What will it cost me?</h2>
        <div class="prose">
          <p>
            Two things: your Cloudgate plan and your server. The Starter plan is
            ${starter.price} a month and covers up to 3 Servers, with a {trialDays}-day free trial
            (a card is needed to start it).
          </p>
          <p>
            A server you buy in the console is billed on the same invoice, monthly, at a price shown
            before you buy. A server you already have costs whatever you pay for it now. Members,
            Projects and Environments are not counted.
          </p>
          <p><a class="text-link" href="/pricing">Compare Cloudgate plans</a></p>
        </div>
      </div>
      <div class="panel bill" aria-hidden="true" data-reveal data-reveal-delay="120" data-spotlight>
        <p class="bill-title">Your monthly bill</p>
        <div class="line"><span><span class="slice"></span>Cloudgate Starter plan</span><strong>${starter.price}</strong></div>
        <div class="line"><span><span class="slice slice--2"></span>A server you buy from us</span><span class="muted">Price shown before you buy</span></div>
        <div class="line or"><span><span class="slice slice--3"></span>Or a server you already have</span><span class="muted">Paid to your provider</span></div>
        <div class="line free"><span>Members, Projects, Environments</span><span>Not counted</span></div>
        <p class="trial">First {trialDays} days free</p>
      </div>
    </div>
  </section>

  <Faq items={faq} title="Questions from people new to deploying" />

  <CtaBand
    title="Your app deserves an address"
    text={`Sign up, get a server and press Deploy. Every plan starts with a ${trialDays}-day free trial.`}
  />
</Base>

<style>
  /* ---- Windows ---- */
  .window.ui,
  .window.browser {
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(180deg, var(--line-strong), var(--line)) border-box;
  }
  .window.term .window-bar {
    border-bottom-color: var(--night-line);
    color: var(--night-muted);
  }
  .window.term .window-bar::before {
    background: var(--night-line);
    box-shadow:
      1rem 0 0 var(--night-line),
      2rem 0 0 var(--night-line);
  }
  .window.term .code {
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .window-bar {
    min-width: 0;
    white-space: nowrap;
  }

  /* ---- Hero: the app, live ---- */
  .hero-visual {
    position: relative;
    padding-bottom: var(--space-6);
  }
  .url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--paper-2);
    font-family: var(--font-mono);
    color: var(--ink-2);
  }
  .browser-body {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }
  .live-pill {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-self: start;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .fake-app {
    display: grid;
    grid-template-columns: 30% 1fr;
    min-height: 220px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--paper);
    overflow: hidden;
  }
  .fa-side {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    border-right: 1px solid var(--line);
    background: var(--paper-2);
  }
  .fa-logo {
    width: 1.6rem;
    height: 1.6rem;
    margin-bottom: var(--space-2);
    border-radius: 6px;
    background: linear-gradient(135deg, var(--slice-1), var(--slice-3));
  }
  .fa-item {
    height: 0.55rem;
    border-radius: 4px;
    background: var(--line-strong);
  }
  .fa-item.on {
    background: var(--brand);
  }
  .fa-item.short,
  .fa-line.short {
    width: 60%;
  }
  .fa-main {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .fa-title {
    width: 55%;
    height: 1rem;
    border-radius: 5px;
    background: var(--ink-2);
    opacity: 0.8;
  }
  .fa-line {
    height: 0.5rem;
    border-radius: 4px;
    background: var(--line-strong);
  }
  .fa-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .fa-cards span {
    height: 3.2rem;
    border-radius: 8px;
    background: var(--brand-tint);
    border: 1px solid var(--line);
  }
  .toast {
    position: absolute;
    left: -6%;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(160deg, var(--beam-b), var(--beam-a) 45%, var(--line) 80%) border-box;
    border: 1px solid transparent;
    box-shadow: 0 20px 50px -20px var(--glow);
    font-size: var(--text-sm);
  }
  .toast strong {
    display: block;
  }
  .toast small {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .tick {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--live-tint);
    color: var(--live);
    font-weight: 700;
  }
  .tick path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  /* The payoff of the page in one beat: once the hero has settled, the "live" notice arrives and
     its check draws. Once per visit, on load; static without JS or with reduced motion. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.js) .toast {
      animation: toast-in 520ms var(--ease-out) 1000ms both;
    }
    :global(.js) .tick path {
      animation: tick-draw 420ms var(--ease-out) 1300ms both;
    }
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0) scale(0.96);
    }
  }
  @keyframes tick-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* ---- How ---- */
  .how {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: start;
  }
  .done {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: 6rem;
  }
  .wiz-body {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .wiz {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: w;
    display: grid;
    gap: var(--space-2);
  }
  .wiz li {
    counter-increment: w;
    display: grid;
    grid-template-columns: 1.6rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }
  .wiz li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .wiz li span:last-child {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .wiz li span.live {
    color: var(--live);
  }
  .wiz .cur {
    border-color: var(--brand);
  }
  .mock {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--line-strong);
  }
  .app-name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
  }
  .addr {
    max-width: 100%;
