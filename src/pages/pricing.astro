    .meter.is-playing .meter-rows .slot--used {
      animation: slot-fill 420ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms + 150ms);
    }
    .meter.is-playing .slots--try .slot--used {
      animation: slot-fill 360ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 70ms + 750ms);
    }
    .meter.is-playing .slot--over {
      animation:
        slot-try 260ms var(--ease-out) 1050ms both,
        slot-refuse 420ms var(--ease-in-out) 1310ms;
    }
    .meter.is-playing .refused p {
      animation: slot-text 500ms var(--ease-out) 1400ms both;
    }
  }
  @keyframes slot-fill {
    from {
      transform: scaleX(0);
