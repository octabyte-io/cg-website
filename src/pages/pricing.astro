  /* In view, the example plays once: each meter fills slot by slot, then the try row fills its
     three and the fourth Server arrives already refused, with a short shake of the head. The
     final state is the static drawing, so without JS or with reduced motion nothing changes. */
  .slot--used,
  .slot--over {
    transform-origin: left center;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.js) .meter:not(.is-playing) .slot--used {
      transform: scaleX(0);
    }
    :global(.js) .meter:not(.is-playing) .slot--over,
    :global(.js) .meter:not(.is-playing) .refused p {
      opacity: 0;
