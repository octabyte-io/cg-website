---
import { templatesHome } from '../data/template-links';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, plans, addOn, trialDays } from '../data/site';
import { softwareSchema, faqSchema, breadcrumbSchema } from '../data/schema';

const trail = [{ name: 'Pricing', path: '/pricing' }];
const [starter, business] = plans;
const enterpriseMail = `mailto:${site.support}?subject=${encodeURIComponent('Cloudgate Enterprise')}`;

const faq = [
  {
    q: 'How does the free trial work?',
    a: `Both hosted plans start with a ${trialDays}-day free trial. You get the plan's full counts from day one, Add-ons cost nothing until the trial ends, and you can switch between Starter and Business while the clock runs. A Server you buy from Cloudgate is charged from the day you buy it, trial or not.`,
  },
  {
    q: 'Do I need a card to start the trial?',
    a: 'Yes. A card is needed to start it, and each Organization, person and card gets one trial. If the trial ends without a card or you cancel, nothing is charged.',
  },
  {
    q: 'Can I cancel at any time?',
    a: `Yes. Plans are paid monthly, with no yearly contract. Moving up to Business takes effect at once and is charged prorated; moving down to Starter takes effect at the end of the paid month and can be taken back until then.`,
  },
  {
    q: 'What is a Cloud Environment?',
    a: 'An Environment that deploys to a cloud account (AWS or Google Cloud). It counts once against your plan however many cloud accounts or regions it uses. Connecting a cloud account counts nothing.',
  },
  {
    q: 'What happens when I go over my plan?',
    a: `Only the next Server or Cloud Environment you try to add is refused. Nothing already running is stopped. Buy an Add-on for $${addOn.price} and you can add one more of each.`,
  },
  {
    q: 'Can I self-host Cloudgate for free?',
    a: 'Yes. You can run Cloudgate on your own Ubuntu server for free under the Elastic License 2.0, with one Organization and one build at a time per Server. An Enterprise license unlocks the rest. See <a href="/self-hosted">how to self-host Cloudgate</a>.',
  },
  {
    q: 'Is Cloudgate open source?',
    a: 'No. Cloudgate is source-available under the Elastic License 2.0: you can use, self-host and modify it for free, but you cannot offer it to others as a hosted service.',
  },
  {
    q: 'Do you offer custom or yearly deals?',
    a: `Yes, through Enterprise. Email <a href="${enterpriseMail}">${site.support}</a> and we agree the price, the counts and the billing period with you.`,
  },
];

type Cell = string | boolean;
const compare: { group: string; rows: { label: string; cells: [Cell, Cell, Cell, Cell] }[] }[] = [
  {
    group: 'Price and counts',
    rows: [
      { label: 'Price', cells: [`$${starter.price} a month`, `$${business.price} a month`, 'Free', 'Agreed with you'] },
      { label: 'Free trial', cells: [`${trialDays} days, card needed`, `${trialDays} days, card needed`, 'Not needed', '30-day trial key on request'] },
      { label: 'Servers', cells: ['3, then $5 per Add-on', '3, then $5 per Add-on', 'Not counted', 'Not counted'] },
      { label: 'Cloud Environments', cells: ['3, then $5 per Add-on', '3, then $5 per Add-on', 'Not counted', 'Not counted'] },
      { label: 'Members, Projects, Environments', cells: ['Not counted', 'Not counted', 'Not counted', 'Not counted'] },
      { label: 'Organizations', cells: ['One, paying for itself', 'Pay for more on one plan', 'One', 'More than one'] },
    ],
  },
  {
    group: 'Deploying',
    rows: [
      { label: 'Apps, databases, Compose stacks, AI models', cells: [true, true, true, true] },
      { label: 'Your own Servers, AWS and Google Cloud', cells: [true, true, true, true] },
      { label: 'Buy a Server from Cloudgate', cells: [true, true, false, false] },
      { label: 'Agents and the MCP endpoint', cells: [true, true, true, true] },
      { label: 'Builds and cloud runs', cells: ['Run by Octabyte', 'Run by Octabyte', 'One at a time per Server', 'In parallel'] },
    ],
  },
  {
    group: 'Access and identity',
    rows: [
      { label: 'Roles, grants and audit log', cells: [true, true, true, true] },
      { label: 'SSO for your proven domains', cells: [false, true, false, true] },
      { label: 'SCIM provisioning', cells: [false, true, false, true] },
      { label: 'Custom roles', cells: [false, true, false, true] },
      { label: 'Forward auth in front of apps', cells: [false, true, false, true] },
      { label: 'White-labelling', cells: [false, false, false, true] },
    ],
  },
  {
    group: 'Running it',
    rows: [
      { label: 'Who runs Cloudgate', cells: ['Octabyte', 'Octabyte', 'You', 'You'] },
      { label: 'Console address', cells: ['cloudgate.octabyte.app', 'cloudgate.octabyte.app', 'Your server', 'Your server'] },
    ],
  },
];

const columns = ['Starter', 'Business', 'Self-hosted, free', 'Self-hosted, Enterprise license'];

const examples = [
  {
    who: 'One team, two servers you already have',
    plan: 'Starter',
    math: `$${starter.price}`,
    total: `$${starter.price}`,
    note: 'Two Servers fit inside the three Starter includes.',
  },
  {
    who: 'One team, five servers',
    plan: 'Starter + 2 Add-ons',
    math: `$${starter.price} + 2 × $${addOn.price}`,
    total: `$${starter.price + 2 * addOn.price}`,
    note: 'Each Add-on raises Servers and Cloud Environments by one.',
  },
  {
    who: 'A company that needs SSO, with four servers and one AWS environment',
    plan: 'Business + 1 Add-on',
    math: `$${business.price} + $${addOn.price}`,
    total: `$${business.price + addOn.price}`,
    note: 'The fourth Server needs one Add-on; the Cloud Environment fits in the three included. AWS bills its own resources to you.',
  },
];

const title = 'Cloudgate pricing: plans from $15 a month, 30-day trial';
const description =
  'Cloudgate hosted plans are $15 or $35 a month with a 30-day free trial, counted by servers and cloud environments, never by seats. Self-host free under ELv2.';
---

<Base
  title={title}
  description={description}
  schema={[softwareSchema(), faqSchema(faq), breadcrumbSchema(trail)]}
>
  <PageHero
    title="Cloudgate pricing: pay for servers, not seats"
    lede={`Two monthly plans for the hosted console, each with a ${trialDays}-day free trial, and a free way to run Cloudgate yourself. Invite as many people and make as many Projects as you like: only Servers and Cloud Environments are counted.`}
    trail={trail}
  />

  <section class="plans-section" aria-labelledby="plans-title">
    <div class="wrap">
      <h2 id="plans-title" class="visually-hidden">Plans</h2>
      <div class="plans">
        <div class="hosted">
          <p class="group-label">
            Hosted at <a href={site.console}>cloudgate.octabyte.app</a>, run by Octabyte
          </p>
          <div class="hosted-cols">
            {plans.map((p) => (
              <article class="plan" aria-labelledby={`plan-${p.id}`}>
                <h3 id={`plan-${p.id}`}>{p.name}</h3>
                <p class="price">
                  <span class="amount">${p.price}</span>
                  <span class="per">a month</span>
                </p>
                <p class="blurb">{p.blurb}</p>
                <ul class="includes">
                  {p.includes.map((line) => <li>{line}</li>)}
                </ul>
                <a class={`btn ${p.id === 'starter' ? 'btn--primary' : 'btn--ghost'}`} href={site.signUp}>
                  Start {trialDays}-day trial
                </a>
              </article>
            ))}
          </div>
          <p class="hosted-foot">
            <strong>Add-on, ${addOn.price} a month:</strong> {addOn.what}, on either plan.
            Monthly only. A card starts the trial; cancel before it ends and nothing is charged.
          </p>
        </div>

        <article class="plan self" aria-labelledby="plan-self">
          <p class="group-label">On your own server</p>
          <h3 id="plan-self">Self-hosted</h3>
          <p class="price">
            <span class="amount">$0</span>
            <span class="per">under the Elastic License 2.0</span>
          </p>
          <p class="blurb">For teams that want to run Cloudgate themselves.</p>
          <ul class="includes">
            <li>Install on one Ubuntu 24.04 server</li>
            <li>One Organization</li>
            <li>One build at a time per Server</li>
            <li>No Server or Cloud Environment counts</li>
            <li>
              An Enterprise license adds SSO, SCIM, custom roles, forward auth, white-labelling,
              parallel builds and more Organizations
            </li>
          </ul>
          <div class="self-actions">
            <a class="btn btn--ghost" href="/self-hosted">How self-hosting works</a>
            <a class="text-link" href={enterpriseMail}>Ask about a license</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="counts-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="counts-title">What counts toward a plan?</h2>
        <p class="lede">
          Two things are counted: Servers and Cloud Environments. Each plan includes three of each,
          and each ${addOn.price} Add-on raises both by one.
        </p>
      </div>
      <div class="counts">
        <div>
          <h3>Counted</h3>
          <dl class="count-list">
            <div>
              <dt>Servers</dt>
              <dd>Every machine you connect over SSH, and every Server you buy from Cloudgate.</dd>
            </div>
            <div>
              <dt>Cloud Environments</dt>
              <dd>
                An Environment that deploys to AWS or Google Cloud. It counts once, however many
                cloud accounts or regions it uses.
              </dd>
            </div>
          </dl>
        </div>
        <div>
          <h3>Not counted</h3>
          <dl class="count-list">
            <div>
              <dt>Members</dt>
              <dd>Invite your whole team, and give AI agents their own member accounts.</dd>
            </div>
            <div>
              <dt>Projects and Environments</dt>
              <dd>Make as many as you need on your Servers. Connecting a cloud account is free too.</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="over">
        <h3>What happens if you go over?</h3>
        <p>
          Only the next addition is refused. If your plan holds three Servers and you try to add a
          fourth, Cloudgate says no and offers an Add-on. Nothing running is switched off, and no
          app is stopped because of a count.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="provider-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="provider-title">What do you pay your server or cloud provider?</h2>
        <p class="lede">
          Your plan pays for Cloudgate. The machines and cloud resources your apps run on are billed
          separately, and who bills you depends on where they come from.
        </p>
      </div>
      <dl class="facts">
        <div>
          <dt>Servers you bring</dt>
          <dd>
            Billed by your provider, as they are today. Cloudgate connects to them over SSH and is
            not part of that bill.
          </dd>
        </div>
        <div>
          <dt>Servers you buy from Cloudgate</dt>
          <dd>
            Billed by us, monthly in advance on the same invoice as your plan, at the provider's
            price plus a markup. You see the full price before you buy.
          </dd>
        </div>
        <div>
          <dt>AWS and Google Cloud resources</dt>
          <dd>
            Billed by AWS or Google to your own cloud account. Cloudgate creates the resources there
            for you, and the bill for them stays between you and your cloud.
          </dd>
        </div>
        <div>
          <dt>Self-hosted</dt>
          <dd>
            You pay for the server Cloudgate runs on, plus whatever your apps run on. Cloudgate
            itself is free unless you buy an Enterprise license.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="examples-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="examples-title">What does a month cost?</h2>
        <p class="lede">
          Three setups, worked out from the prices on this page. Each total is what you pay
          Cloudgate; your servers and cloud resources are billed on top as described above.
        </p>
      </div>
      <div class="table-wrap" role="region" aria-labelledby="examples-title" tabindex="0">
        <table class="examples">
          <thead>
            <tr>
              <th scope="col">Setup</th>
              <th scope="col">Plan</th>
              <th scope="col">Sum</th>
              <th scope="col">Cloudgate a month</th>
            </tr>
          </thead>
          <tbody>
            {examples.map((e) => (
              <tr>
                <th scope="row">
                  {e.who}
                  <span class="row-note">{e.note}</span>
                </th>
                <td>{e.plan}</td>
                <td class="num">{e.math}</td>
                <td class="num total">
                  {e.total}
                  <span class="plus">plus your servers</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="compare-title">How do the plans compare?</h2>
        <p class="lede">
          Every way of running Cloudgate deploys the same things. The differences are who runs it,
          what is counted, and the identity features larger companies ask for.
        </p>
      </div>
      <div class="table-wrap" role="region" aria-labelledby="compare-title" tabindex="0">
        <table class="compare">
          <thead>
            <tr>
              <td></td>
              {columns.map((c, i) => <th scope="col" class={i >= 2 ? 'col-self' : undefined}>{c}</th>)}
            </tr>
          </thead>
          {compare.map((g) => (
            <tbody>
              <tr class="group">
                <th scope="colgroup" colspan="5">{g.group}</th>
              </tr>
              {g.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.cells.map((c, i) => (
                    <td class={i >= 2 ? 'col-self' : undefined}>
                      {c === true ? (
                        <span class="yes"><span class="tick" aria-hidden="true"></span><span class="visually-hidden">Included</span></span>
                      ) : c === false ? (
                        <span class="no"><span aria-hidden="true">–</span><span class="visually-hidden">Not included</span></span>
                      ) : (
                        c
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <div class="enterprise">
        <h3>Need something the plans don't cover?</h3>
        <p>
          Enterprise is a custom deal on the hosted console, with counts set for you and the
          Business features included. For a self-hosted Enterprise license we agree the price and
          billing period with you. Write to <a href={enterpriseMail}>{site.support}</a>.
        </p>
      </div>
      <p class="more">
        Not sure where to start? <a href={templatesHome}>Deploy an app from a template</a> during the
        trial, read <a href="/features">what Cloudgate does</a>, or see how
        {" "}<a href="/ai-agents">AI agents deploy through Cloudgate</a>.
      </p>
    </div>
  </section>

  <Faq items={faq} />
  <CtaBand />
</Base>

<style>
  .plans-section {
    padding-bottom: var(--space-9);
  }
  .plans {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: stretch;
  }
  .group-label {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .group-label a {
    color: var(--ink);
  }

  .hosted {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
  .hosted-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .hosted-cols .plan + .plan {
    border-left: 1px solid var(--line);
    padding-left: var(--space-6);
    margin-left: var(--space-6);
  }
  .hosted-foot {
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .hosted-foot strong {
    color: var(--ink);
    font-weight: 600;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .plan h3 {
    font-size: var(--text-xl);
  }
  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .amount {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--text-3xl);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .per {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .blurb {
    color: var(--ink-2);
  }
  .includes {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 var(--space-4);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--muted);
    flex: 1;
  }
  .includes li {
    padding-left: 1.1rem;
    position: relative;
  }
  .includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.45rem;
    height: 2px;
    background: var(--line-strong);
  }
  .plan .btn {
    align-self: flex-start;
  }

  .self {
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    background: transparent;
  }
  .self-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--brand);
  }

  .counts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7);
  }
  .counts h3 {
    margin-bottom: var(--space-4);
  }
  .count-list {
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .count-list > div {
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }
  .count-list dt {
    font-weight: 600;
  }
  .count-list dd {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }
  .over {
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-6);
    background: var(--live-tint);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-2);
    max-width: 820px;
  }
  .over p {
    color: var(--ink-2);
  }

  .table-wrap {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    -webkit-overflow-scrolling: touch;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  tbody:last-child tr:last-child > *,
  .examples tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  tbody th {
    font-weight: 500;
    color: var(--ink);
  }

  .examples {
    min-width: 680px;
  }
  .row-note {
    display: block;
    margin-top: var(--space-1);
    color: var(--muted);
    font-weight: 400;
    max-width: 44ch;
  }
  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .total {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .plus {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    margin-top: var(--space-1);
  }

  .compare {
    min-width: 820px;
  }
  .compare thead th {
    width: 19%;
  }
  .compare tbody th[scope='row'] {
    width: 24%;
  }
  .compare .col-self {
    background: var(--paper-2);
  }
  .compare tr.group th {
    padding-top: var(--space-5);
    padding-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--muted);
    background: var(--surface);
  }
  .compare td {
    color: var(--ink-2);
  }
  .tick {
    display: inline-block;
    width: 0.8rem;
    height: 0.45rem;
    border-left: 2px solid var(--live);
    border-bottom: 2px solid var(--live);
    transform: rotate(-45deg) translateY(-0.1rem);
  }
  .no {
    color: var(--line-strong);
  }

  .enterprise {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-2);
    max-width: 68ch;
  }
  .enterprise p,
  .more {
    color: var(--muted);
  }
  .enterprise a,
  .more a {
    color: var(--ink);
  }
  .more {
    margin-top: var(--space-6);
    max-width: 68ch;
  }

  @media (max-width: 960px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hosted,
    .self {
      padding: var(--space-5);
    }
    .hosted-cols {
      grid-template-columns: 1fr;
    }
    .hosted-cols .plan + .plan {
      border-left: 0;
      padding-left: 0;
      margin-left: 0;
      border-top: 1px solid var(--line);
      padding-top: var(--space-5);
      margin-top: var(--space-5);
    }
    .counts {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .over {
      padding: var(--space-5);
    }
  }
</style>
