---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ConsoleShot from '../components/ConsoleShot.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { tour } from '../data/tour';
import { faqSchema, breadcrumbSchema } from '../data/schema';

const trail = [{ name: 'Console tour', path: '/tour' }];

const title = 'Cloudgate console tour: deploys, logs, Plans and agents';
const description =
  'Real screenshots of the Cloudgate console: a deploy as it builds, its log, a Plan to Apply, uptime checks, Agents, Server telemetry and buying a Server.';

const faq = [
  {
    q: 'Are these real screenshots of Cloudgate?',
    a: 'Yes. They are captures of the Cloudgate console running with a made-up company, Northwind Labs, and its made-up data. The same screenshots illustrate the <a href="/docs">documentation</a>, in both the light and the dark theme.',
  },
  {
    q: 'Is the console the same when I self-host Cloudgate?',
    a: 'Yes, it is the same console. Buying a Server and billing are on the Hosted instance only; a <a href="/self-hosted">self-hosted Cloudgate</a> connects your own Servers over SSH instead.',
  },
  {
    q: 'Do I have to use the console?',
    a: 'No. You can deploy a folder with the <a href="/cli">Cloudgate CLI</a>, let <a href="/ai-agents">your AI agent deploy over MCP</a>, or call the REST API with a personal key. The console is where you see all of it in one place.',
  },
];

const sizes = '(min-width: 1264px) 780px, (min-width: 900px) 64vw, calc(100vw - 2rem)';
---

<Base title={title} description={description} schema={[faqSchema(faq), breadcrumbSchema(trail)]}>
  <PageHero
    title="A tour of the Cloudgate console"
    lede="Eight real screens, from pressing Deploy to buying a Server. The company and its data are made up; the console is the one you sign in to."
    trail={trail}
  >
    <a class="btn btn--primary" href={site.signUp}>Start free trial</a>
    <a class="btn btn--ghost" href="/features">Every feature</a>
  </PageHero>

  {tour.map((s, n) => (
    <section class:list={['section stop', { band: n % 2 === 1 }]} aria-labelledby={s.id}>
      <div class:list={['wrap stop-grid', { 'stop-grid--flip': n % 2 === 1 }]}>
        <div class="stop-copy" data-reveal>
          <h2 id={s.id}>{s.question}</h2>
          <p>{s.caption}</p>
          <a class="text-link" href={s.docs.href}>{s.docs.label}</a>
        </div>
        <div class="stop-shot" data-reveal data-reveal-delay="80">
          <ConsoleShot stop={s} sizes={sizes} eager={n === 0} />
        </div>
      </div>
    </section>
  ))}

  <section class="section band" aria-labelledby="next">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="next">Where do I go from here?</h2>
        <p class="lede">
          Read how each part works in the <a href="/docs/guide/get-started">user guide</a>, see
          <a href="/ai-models">how AI models run on your own GPUs</a>, or compare
          <a href="/pricing">the plans and the free trial</a>.
        </p>
      </div>
    </div>
  </section>

  <Faq items={faq} />
  <CtaBand title="Try the console yourself" />
</Base>

<style>
  .stop {
    padding-block: var(--space-8);
  }
  .stop-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-7);
    align-items: start;
  }
  .stop-copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-top: var(--space-5);
    /* Beside a tall screenshot the words stay in view while it scrolls past. */
    position: sticky;
    top: 6rem;
  }
  .stop-grid--flip {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }
  .stop-grid--flip .stop-copy {
    order: 2;
  }
  .stop-copy h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .stop-copy p {
    color: var(--muted);
    max-width: 44ch;
  }
  .lede a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .lede a:hover {
    text-decoration-color: var(--brand);
  }
  @media (max-width: 900px) {
    .stop-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
    .stop-grid--flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .stop-grid--flip .stop-copy {
      order: 0;
    }
    .stop-copy {
      position: static;
      padding-top: 0;
    }
    .stop-copy h2 {
      font-size: var(--text-xl);
    }
    .stop-copy p {
      max-width: 62ch;
    }
  }
</style>
