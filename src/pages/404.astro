---
import { templatesHome } from '../data/template-links';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist. Find Cloudgate's features, templates and pricing from here." noindex>
  <section class="wrap nf">
    <h1>This page is not here</h1>
    <p class="lede">The address may have changed. These are the pages most people look for.</p>
    <ul>
      <li><a class="text-link" href="/">Cloudgate home</a></li>
      <li><a class="text-link" href={templatesHome}>Deploy an app template</a></li>
      <li><a class="text-link" href="/pricing">Pricing</a></li>
      <li><a class="text-link" href="/ai-agents">Cloudgate for AI agents</a></li>
    </ul>
  </section>
</Base>
<style>
  .nf { padding-block: var(--space-9); display: grid; gap: var(--space-5); }
  ul { display: grid; list-style: none; margin: 0; padding: 0; }
</style>
