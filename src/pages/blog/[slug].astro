---
// One blog post from src/content/blog, at /blog/<its file name>. The byline's dates and author are the
// ones its BlogPosting JSON-LD carries, so what readers see and what search engines read agree.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbSchema, faqSchema } from '../../data/schema';
import { authorById } from '../../data/authors';
import { getPosts, postUrl, authorUrl, modifiedOf, longDate, topics, blogPostingSchema, type Post } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content, headings } = await render(post);
const d = post.data;
const author = authorById(d.author);
const modified = modifiedOf(post);
const wasUpdated = modified !== d.published;
const trail = [
  { name: 'Blog', path: '/blog' },
  { name: d.title, path: postUrl(post) },
];
const contents = headings.filter((h) => h.depth === 2);
// Up to three more posts: the same topic first, then the newest.
const more = [
  ...posts.filter((p) => p.id !== post.id && p.data.topic === d.topic),
  ...posts.filter((p) => p.id !== post.id && p.data.topic !== d.topic),
].slice(0, 3);
const schema = [breadcrumbSchema(trail), blogPostingSchema(post), ...(d.faq?.length ? [faqSchema(d.faq)] : [])];
---

<Base title={d.seoTitle ?? d.title} description={d.description} schema={schema} modified={modified} ogType="article">
  <PageHero title={d.title} lede={d.lede} trail={trail} compact>
    <p class="byline">
      <span>By <a href={authorUrl(author.id)} rel="author">{author.name}</a></span>
      <span>Published <time datetime={d.published}>{longDate(d.published)}</time></span>
      {wasUpdated && <span>Updated <time datetime={modified}>{longDate(modified)}</time></span>}
      <span><a href={`/blog#${d.topic}`}>{topics[d.topic].name}</a></span>
    </p>
  </PageHero>

  <section class="section post-section">
    <div class="wrap post-layout">
      <article class="post">
        <Content />
      </article>
      <aside class="post-side" aria-label="About this post">
        {contents.length > 2 && (
          <nav aria-label="On this page" data-spy>
            <p class="side-title">On this page</p>
            <ol>{contents.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {d.related.length > 0 && (
          <div>
            <p class="side-title">Read next on this site</p>
            <ul>{d.related.map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
          </div>
        )}
        <p class="side-feed">
          <a class="text-link" href="/blog.xml" type="application/rss+xml">Follow the blog (RSS)</a>
        </p>
      </aside>
    </div>
  </section>

  {d.faq?.length ? <Faq items={d.faq} /> : null}

  {more.length > 0 && (
    <section class="section band" aria-labelledby="more-posts">
      <div class="wrap">
        <h2 id="more-posts" class="more-title">More from the Cloudgate blog</h2>
        <ul class="more-list">
          {more.map((p) => (
            <li>
              <a href={postUrl(p)} data-spotlight>
                <strong>{p.data.title}</strong>
                <span>{p.data.description}</span>
                <small><time datetime={p.data.published}>{longDate(p.data.published)}</time></small>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .byline a {
    color: var(--ink);
    font-weight: 500;
  }
  .byline a:hover {
    color: var(--brand);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    gap: var(--space-8);
    align-items: start;
  }

  /* The post: running text at a reading measure, headings that are the questions it answers. */
  .post {
    min-width: 0;
    max-width: 68ch;
    color: var(--ink-2);
  }
  .post > :global(* + *) {
    margin-top: var(--space-4);
  }
  .post :global(h2) {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    color: var(--ink);
    scroll-margin-top: 6rem;
  }
  .post :global(h3) {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--ink);
    scroll-margin-top: 6rem;
  }
  .post :global(:is(h2, h3) + *) {
    margin-top: var(--space-3);
  }
  .post :global(:is(ul, ol)) {
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-2);
  }
  .post :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .post :global(a) {
    color: var(--brand);
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .post :global(a:hover) {
    color: var(--brand-hi);
    text-decoration-color: currentColor;
  }
  .post :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .post :global(pre) {
    overflow-x: auto;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }
  .post :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
  }
  .post :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .post :global(:is(th, td)) {
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .post :global(th) {
    color: var(--ink);
    font-weight: 600;
  }

  .post-side {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: var(--space-6);
    font-size: var(--text-sm);
  }
  .side-title {
    margin: 0 0 var(--space-2);
    color: var(--muted);
  }
  .post-side :is(ol, ul) {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-4);
    border-left: 1px solid var(--line);
    display: grid;
  }
  .post-side li a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
  }
  .post-side li a:hover,
  .post-side li a[aria-current='location'] {
    color: var(--brand);
  }
  .side-feed {
    margin: 0;
  }

  .more-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }
  .more-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
  }
  .more-list a {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
  }
  .more-list strong {
    color: var(--ink);
    font-size: var(--text-md);
    line-height: 1.35;
  }
  .more-list a:hover strong {
    color: var(--brand);
  }

  @media (max-width: 960px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
    .post-side {
      position: static;
    }
    .post-side nav {
      display: none;
    }
  }
</style>
