---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const trail = [{ name: 'About', path: '/about' }];
const accessMail = `mailto:${site.support}?subject=${encodeURIComponent('Access to self-host Cloudgate')}`;

const title = 'About Cloudgate: a deployment platform for servers you own';
const description =
  'Cloudgate deploys apps, databases and AI models to servers and cloud accounts you own, for people, vibe coders and AI agents. Source-available, by Octabyte.';

const aboutPage = {
  '@type': 'AboutPage',
  name: 'About Cloudgate',
  url: `${site.url}/about`,
  about: { '@id': `${site.url}/#organization` },
};
---

<Base title={title} description={description} schema={[aboutPage, breadcrumbSchema(trail)]}>
  <PageHero
    title="About Cloudgate"
    lede="Cloudgate is a deployment platform you point at machines you own: your own servers, your AWS account or your Google Cloud project. It builds and runs your apps, databases and AI models there, with domains, certificates, backups and monitoring built in."
    trail={trail}
  >
    <a class="btn btn--primary" href="/features">See what it does</a>
    <a class="btn btn--ghost" href="/contact">Contact us</a>
    <figure class="lanes panel" slot="visual" aria-label="Three ways in: the console, your AI agent and your terminal. Three places to run: your own Server, AWS and Google Cloud.">
      <div class="col">
        <p class="col-title">Ways in</p>
        <ul>
          <li><span class="slice" aria-hidden="true"></span>The console</li>
          <li><span class="slice slice--2" aria-hidden="true"></span>Your AI agent</li>
          <li><span class="slice slice--3" aria-hidden="true"></span>Your terminal</li>
        </ul>
      </div>
      <div class="gate" aria-hidden="true">
        <span>Cloudgate</span>
      </div>
      <div class="col">
        <p class="col-title">Places to run</p>
        <ul>
          <li><span class="slice" aria-hidden="true"></span>Your own Server</li>
          <li><span class="slice slice--2" aria-hidden="true"></span>AWS</li>
          <li><span class="slice slice--3" aria-hidden="true"></span>Google Cloud</li>
        </ul>
      </div>
    </figure>
  </PageHero>

  <section class="section" aria-labelledby="what-title">
    <div class="wrap split">
      <div class="section-head" data-reveal>
        <h2 id="what-title">What is Cloudgate?</h2>
        <p class="lede">
          A deployment platform that runs on your infrastructure, not on ours. You bring the
          machines, Cloudgate does the deploying.
        </p>
      </div>
      <dl class="facts one" data-reveal-stagger>
        <div>
          <dt>It deploys to Servers you connect</dt>
          <dd>
            Any Ubuntu machine over SSH, or the machine Cloudgate itself runs on. Cloudgate sets it up
            with Docker Swarm and Traefik, and gets Let's Encrypt certificates for your domains.
          </dd>
        </div>
        <div>
          <dt>And into your cloud accounts</dt>
          <dd>
            On AWS it uses ECS, RDS, ElastiCache, S3 and CloudFront; on Google Cloud, Cloud Run, Cloud
            SQL and Memorystore. Cloudgate makes them with OpenTofu and shows drift when someone
            changes them by hand.
          </dd>
        </div>
        <div>
          <dt>It runs whole apps</dt>
          <dd>
            Web apps, workers, cron jobs, static sites, Compose stacks, managed databases and AI
            models, organised as Organization, Project, Environment and Service.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section band" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="why-title">Why does Cloudgate exist?</h2>
        <p class="lede">
          Because putting an app online should not mean handing your infrastructure to a platform.
          Cloudgate gives the Heroku-style experience on machines you already own or can buy, and it
          was built for three kinds of user from the start.
        </p>
      </div>
      <div class="readers" data-reveal-stagger="80">
        <div class="reader" data-spotlight>
          <span class="slice" aria-hidden="true"></span>
          <h3>People who build with AI</h3>
          <p>
            You made an app with an AI tool and want it online. Pick a template or point Cloudgate at
            your folder, get a server from us or bring your own, press Deploy, get an address.
          </p>
          <a class="text-link" href="/vibe-coding">How to put an AI-built app online</a>
        </div>
        <div class="reader" data-spotlight>
          <span class="slice slice--2" aria-hidden="true"></span>
          <h3>AI agents</h3>
          <p>
            An Agent is a member of your Organization with its own role, grant and keys. Over MCP it
            can deploy, read logs and health, and open previews that expire, and every call is in the
            audit log.
          </p>
          <a class="text-link" href="/ai-agents">How AI agents deploy with Cloudgate</a>
        </div>
        <div class="reader" data-spotlight>
          <span class="slice slice--3" aria-hidden="true"></span>
          <h3>Developers and teams</h3>
          <p>
            Push-to-deploy from git, a terminal command, or one <code>cloudgate.yaml</code> reviewed as
            a Plan, on your own servers, AWS or Google Cloud, with roles and grants for everyone.
          </p>
          <a class="text-link" href="/cli">Deploy from your terminal with the CLI</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="built-title">
    <div class="wrap split">
      <div class="section-head" data-reveal>
        <h2 id="built-title">How is Cloudgate built?</h2>
        <p class="lede">
          One backend, one web console and a command-line tool, written in TypeScript and developed
          together.
        </p>
        <figure class="arch" data-play aria-label="The console, the CLI and AI agents all reach one NestJS backend with its PostgreSQL database; the backend deploys to your own Servers, AWS and Google Cloud.">
          <ul class="arch-row" aria-hidden="true">
            <li style="--i:0"><span class="slice"></span><span>Console<small>Next.js</small></span></li>
            <li style="--i:1"><span class="slice slice--2"></span><span>CLI<small>npm</small></span></li>
            <li style="--i:2"><span class="slice slice--3"></span><span>AI agent<small>MCP</small></span></li>
          </ul>
          <div class="arch-links" aria-hidden="true"><span style="--i:0"></span><span style="--i:1"></span><span style="--i:2"></span></div>
          <div class="arch-core" aria-hidden="true">
            <p>Backend <small>NestJS</small></p>
            <div class="arch-parts"><span>API</span><span>Deploy engine</span><span>Job queue</span><span>/mcp</span></div>
            <p class="arch-db">PostgreSQL</p>
          </div>
          <div class="arch-links arch-links--out" aria-hidden="true"><span style="--i:3"></span><span style="--i:4"></span><span style="--i:5"></span></div>
          <ul class="arch-row arch-row--out" aria-hidden="true">
            <li style="--i:3"><span>Your Servers</span></li>
            <li style="--i:4"><span>AWS</span></li>
            <li style="--i:5"><span>Google Cloud</span></li>
          </ul>
        </figure>
      </div>
      <dl class="facts one" data-reveal-stagger>
        <div>
          <dt>A backend and a console</dt>
          <dd>
            A single NestJS application holds the API, the deploy engine and the job queue, with
            PostgreSQL as its database. The console is a Next.js app written against that API.
          </dd>
        </div>
        <div>
          <dt>A CLI on npm</dt>
          <dd>
            <code>@octabyte-io/cloudgate</code> logs in through the console, uploads a folder,
            follows the build and sets variables by name. It is still early: the current release is a
            beta.
          </dd>
        </div>
        <div>
          <dt>An MCP endpoint for agents</dt>
          <dd>
            Built into the backend at your console's address plus <code>/mcp</code>, with rate limits,
            an audit row for every call and a mask over every result.
          </dd>
        </div>
        <div>
          <dt>Decisions written down</dt>
          <dd>
            Every architecture decision is a short record with the alternatives that were rejected,
            and the product's words (Server, Project, Environment, Service, Deployment, Plan) mean one
            thing each, in the code and on this site.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section band" aria-labelledby="license-title">
    <div class="wrap license">
      <div data-reveal>
        <h2 id="license-title">How is Cloudgate licensed?</h2>
        <p class="lede">
          Cloudgate is source-available under the Elastic License 2.0. Anyone, a person or a
          business, may use, self-host and modify it for free. You may not offer Cloudgate to others
          as a hosted service, or work around the license checks that protect its paid features.
        </p>
      </div>
      <div class="license-side panel" data-reveal data-reveal-delay="120">
        <p>
          The source repository is private today, so we give access to each team that wants to
          self-host. The hosted console at <a href={site.console}>{site.console.replace('https://', '')}</a>
          {' '}runs the same Cloudgate.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="/license">Read the license in plain English</a>
          <a class="btn btn--ghost" href={accessMail}>Ask for self-host access</a>
        </div>
        <p class="side-more">Or read <a href="/self-hosted">how to self-host Cloudgate on one server</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-title">
    <div class="wrap split">
      <div class="section-head" data-reveal>
        <h2 id="who-title">Who makes Cloudgate?</h2>
        <p class="lede">
          Cloudgate is made by <a href={site.company.url}>{site.company.name}</a>, which also runs the
          hosted console and the public catalogue of app templates.
        </p>
      </div>
      <div class="prose" data-reveal data-reveal-delay="120">
        <p>
          Cloudgate is feature-complete for its first release, and the server reports version 0.1.0.
          Everything that changes for the people who run it is written up release by release in
          {' '}<a href="/changelog">the Cloudgate changelog</a>.
        </p>
        <p>
          Questions, sales or a security report: every route is on <a href="/contact">the contact
          page</a>, and how we protect your apps is on <a href="/security">the security page</a>.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .lanes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  .col-title {
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  .lanes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .lanes li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    padding: 0.4rem var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  .gate {
    display: grid;
    place-items: center;
    align-self: stretch;
    position: relative;
  }
  .gate::before {
    content: '';
    position: absolute;
    inset: 10% 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--brand), transparent);
  }
  .gate span {
    position: relative;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--brand);
    background: var(--brand-tint);
    color: var(--brand);
  }

  /* ---- How it is built: the three ways in, one backend, the three places to run ---- */
  .arch {
    margin: var(--space-4) 0 0;
    display: grid;
    max-width: 30rem;
  }
  .arch-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .arch-row li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    padding: 0.45rem var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.2;
  }
  .arch-row small {
    display: block;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .arch-row .slice {
    width: 0.45rem;
    height: 0.9rem;
  }
  .arch-row--out li {
    justify-content: center;
    text-align: center;
    background: var(--paper-2);
    color: var(--ink-2);
  }
  .arch-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    height: 1.4rem;
  }
  .arch-links span {
    justify-self: center;
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: linear-gradient(180deg, var(--line-strong), var(--brand));
    transform-origin: top;
  }
  .arch-links--out span {
    background: linear-gradient(180deg, var(--brand), var(--line-strong));
  }
  .arch-core {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--brand);
    background: var(--brand-tint);
    box-shadow: 0 0 40px -14px var(--glow);
  }
  .arch-core p {
    font-family: var(--font-display);
    font-weight: 650;
    color: var(--ink);
  }
  .arch-core small {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--muted);
    margin-left: var(--space-2);
  }
  .arch-parts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .arch-parts span,
  .arch-core .arch-db {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
  .arch-core .arch-db {
    justify-self: start;
    font-family: var(--font-sans);
    font-weight: 500;
  }
  /* In view it plays once, top to bottom, the way a deploy travels: the ways in, their links into
     the backend, then the links out to the places to run. Static without JS or reduced motion. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.js) .arch:not(.is-playing) li {
      opacity: 0;
    }
    :global(.js) .arch:not(.is-playing) .arch-links span {
      transform: scaleY(0);
    }
    .arch.is-playing li {
      animation: arch-in 500ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 70ms + 150ms);
    }
    .arch.is-playing .arch-row--out li {
      animation-delay: calc((var(--i) - 3) * 70ms + 1000ms);
    }
    .arch.is-playing .arch-links span {
      animation: arch-link 420ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 70ms + 400ms);
    }
    .arch.is-playing .arch-links--out span {
      animation-delay: calc((var(--i) - 3) * 70ms + 780ms);
    }
  }
  @keyframes arch-in {
    from {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
    }
  }
  @keyframes arch-link {
    from {
      transform: scaleY(0);
    }
  }

  .facts.one {
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .readers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .reader {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .reader p {
    color: var(--muted);
  }
  .reader .text-link {
    margin-top: auto;
  }

  .license {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .license h2 {
    margin-bottom: var(--space-4);
  }
  .license-side {
    display: grid;
    gap: var(--space-5);
  }
  .side-more {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .readers {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .license {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
  @media (max-width: 520px) {
    .lanes {
      grid-template-columns: 1fr;
    }
    .gate::before {
      display: none;
    }
    .gate {
      justify-items: start;
    }
    .reader {
      padding: var(--space-5);
    }
  }
</style>
