---
// The product's release notes, copied by hand from the cloudgate repository's CHANGELOG.md and
// cli/CHANGELOG.md into src/content/changelog.md (the repository is not part of this site's
// build), with internal references taken out. Rendered as a timeline: ## is a release, ### an entry.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../data/schema';
import { Content, getHeadings } from '../content/changelog.md';

const trail = [{ name: 'Changelog', path: '/changelog' }];
const headings = getHeadings();
const releases = headings
  .filter((h) => h.depth === 2)
  .map((r) => ({
    ...r,
    count: (() => {
      const i = headings.indexOf(r);
      const next = headings.findIndex((h, j) => j > i && h.depth === 2);
      return headings.slice(i + 1, next === -1 ? undefined : next).filter((h) => h.depth === 3).length;
    })(),
  }));

const title = 'Cloudgate changelog: what is new in each release and beta';
const description =
  'What changed in Cloudgate, release by release: the get-started wizard, bought servers, templates, AI agents over MCP, cloud builds and the command-line tool.';
---

<Base title={title} description={description} schema={[breadcrumbSchema(trail)]}>
  <PageHero
    title="Cloudgate changelog"
    lede="What changed for the people who use and run Cloudgate, newest first. The platform's releases are numbered from 0.2.0; the command-line tool has numbered beta releases on npm."
    trail={trail}
  >
    <a class="btn btn--primary" href="#timeline">Read the latest changes</a>
    <a class="btn btn--ghost" href="/features">See every feature</a>
  </PageHero>

  <section class="section" id="timeline" aria-label="Releases">
    <div class="wrap layout">
      <nav class="toc" data-spy aria-label="Releases on this page">
        <p class="toc-title">Releases</p>
        <ol>
          {releases.map((r) => (
            <li>
              <a href={`#${r.slug}`}>{r.text}</a>
              <span>{r.count} {r.count === 1 ? 'change' : 'changes'}</span>
            </li>
          ))}
        </ol>
        <p class="toc-more">
          New here? Start with <a href="/ai-agents">AI agents over MCP</a>,
          {' '}<a href="/cli">the Cloudgate CLI</a> or <a href="/self-hosted">self-hosting</a>.
        </p>
      </nav>
      <div class="timeline" data-reveal>
        <Content />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .toc {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }
  .toc-title {
    color: var(--muted);
    margin: 0;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
    border-left: 1px solid var(--line);
  }
  .toc li {
    display: grid;
    padding-left: var(--space-4);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    line-height: 1.3;
  }
  .toc a:hover {
    color: var(--brand);
  }
  /* The release being read (motion.ts marks it): a brand rule on the contents line beside it. */
  .toc li {
    position: relative;
  }
  .toc li::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.6rem;
    height: 1.6rem;
    width: 2px;
    border-radius: 1px;
    background: var(--brand);
    opacity: 0;
    transform: scaleY(0.4);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .toc li:has(a[aria-current='location'])::before {
    opacity: 1;
    transform: none;
  }
  .toc a[aria-current='location'] {
    color: var(--brand);
  }
  .toc li span {
    color: var(--muted);
    font-size: var(--text-xs);
    margin-top: -0.6rem;
    margin-bottom: var(--space-2);
  }
  .toc-more {
    color: var(--muted);
  }

  /* The rendered markdown: each ## is a release, each ### an entry on the line. */
  .timeline {
    min-width: 0;
    max-width: 72ch;
  }
  /* Geist's zero is wide, so ch overstates the measure: cap running text near 75 characters. */
  .timeline :global(:is(p, li)) {
    max-width: 58ch;
  }
  .timeline :global(h2) {
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
    scroll-margin-top: 6rem;
    padding-top: var(--space-7);
    margin-bottom: var(--space-4);
  }
  .timeline :global(h2:first-child) {
    padding-top: 0;
  }
  .timeline :global(h2 + p) {
    color: var(--muted);
    margin-bottom: var(--space-5);
  }
  .timeline :global(h3) {
    position: relative;
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    padding-left: var(--space-6);
    scroll-margin-top: 6rem;
  }
  .timeline :global(h3::before) {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.45em;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--brand);
  }
  .timeline :global(h3 ~ p),
  .timeline :global(h3 ~ ul) {
    position: relative;
    padding-left: var(--space-6);
    color: var(--ink-2);
  }
  .timeline :global(h3 + p::before),
  .timeline :global(h3 ~ p::before) {
    content: '';
    position: absolute;
    left: calc(0.2rem + 0.325rem - 0.5px);
    top: -1.2rem;
    bottom: -0.2rem;
    width: 1px;
    background: var(--line);
  }
  .timeline :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .timeline :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .toc {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .timeline :global(h3),
    .timeline :global(h3 ~ p) {
      padding-left: var(--space-5);
    }
  }
</style>
