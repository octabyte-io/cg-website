---
import { templatesHome } from '../data/template-links';
import Mark from './Mark.astro';
import { site } from '../data/site';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/ai-agents', label: 'Cloudgate for AI agents' },
      { href: '/vibe-coding', label: 'Deploy an app you built with AI' },
      { href: templatesHome, label: 'App templates' },
      { href: '/cli', label: 'Command-line tool' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { href: '/docs', label: 'Documentation' },
      { href: '/docs/quickstart', label: 'Quickstart' },
      { href: '/docs/guide/get-started', label: 'User guide' },
      { href: '/docs/api', label: 'API reference' },
      { href: '/docs/cli', label: 'CLI guide' },
      { href: '/docs/mcp', label: 'MCP and agents' },
    ],
  },
  {
    title: 'Run it',
    links: [
      { href: '/pricing', label: 'Pricing' },
      { href: '/self-hosted', label: 'Self-host Cloudgate' },
      { href: site.getStarted, label: 'Get started in the console' },
      { href: site.signIn, label: 'Sign in' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Cloudgate' },
      { href: '/compare', label: 'Compare Cloudgate' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/security', label: 'Security' },
      { href: '/license', label: 'License' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Elsewhere',
    links: [
      { href: site.sourceUrl, label: 'Cloudgate source on GitHub' },
      { href: site.templatesRepo, label: 'Template catalogue on GitHub' },
      { href: site.npm, label: 'CLI on npm' },
      { href: `mailto:${site.support}`, label: site.support },
      { href: '/llms.txt', label: 'llms.txt for AI assistants' },
    ],
  },
];
const legalLinks = [
  { href: '/legal', label: 'Legal' },
  { href: '/terms', label: 'Terms' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/acceptable-use', label: 'Acceptable use' },
  { href: '/cookies', label: 'Cookies' },
  { href: '/subprocessors', label: 'Subprocessors' },
  { href: '/dpa', label: 'DPA' },
];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href="/" aria-label="Cloudgate home"><Mark size={40} /><span>Cloudgate</span></a>
      <p>Deploy apps, databases and AI models to servers and cloud accounts you own. Made by {site.company.name}.</p>
    </div>
    {columns.map((col) => (
      <nav aria-label={col.title}>
        <h2>{col.title}</h2>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="wrap">
    <div class="legal">
      <p>© {year} {site.company.name}. Cloudgate is source-available under the <a href="/license">Elastic License 2.0</a>.</p>
      <nav aria-label="Legal">
        <ul>{legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(5, 1fr);
    gap: var(--space-7);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    min-height: 44px;
    margin-bottom: var(--space-3);
  }
  .about p {
    color: var(--muted);
    max-width: 34ch;
  }
  h2 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: var(--space-3);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  ul a {
    color: var(--muted);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    ul a:hover {
      color: var(--ink);
      text-decoration: underline;
    }
  }
  .legal {
    margin-top: var(--space-8);
    color: var(--muted);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .legal p {
    margin: 0;
  }
  .legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .legal a {
    color: var(--muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .legal a:hover {
      color: var(--ink);
    }
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
    ul {
      gap: 0;
    }
    /* 44px rows; a label that wraps keeps its lines together and its distance from the next link. */
    ul a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-block: var(--space-2);
      line-height: 1.35;
    }
    .legal ul {
      row-gap: 0;
    }
  }
</style>
