---
import { templatesHome } from '../data/template-links';
// The page's one dark band: a closing call to action.
import { site, trialDays } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = 'Put your next app online today',
  text = `Every plan starts with a ${trialDays}-day free trial. Bring a server, buy one from us, or connect AWS or Google Cloud.`,
} = Astro.props;
---
<section class="band" aria-labelledby="cta-title" data-loop>
  <div class="beam" aria-hidden="true"></div>
  <div class="wrap inner" data-reveal>
    <h2 id="cta-title">{title}</h2>
    <p>{text}</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.signUp}>Start free trial</a>
      <a class="btn btn--on-night" href={templatesHome}>Deploy a template</a>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    background: var(--night);
    color: var(--night-ink);
    padding-block: var(--space-9);
    border-block: 1px solid var(--night-line);
    isolation: isolate;
  }
  /* A narrow beam through the keyhole of the mark: the page's one dramatic moment. */
  .beam {
    position: absolute;
    inset: -20% auto -20% 62%;
    width: 140px;
    background: linear-gradient(180deg, transparent, var(--beam-a) 45%, var(--beam-b) 55%, transparent);
    filter: blur(48px);
    opacity: 0.55;
    transform: skewX(-12deg);
    z-index: -1;
  }
  /* The beam drifts slowly across the band and back, and a fainter second beam trails it. */
  .beam::after {
    content: '';
    position: absolute;
    inset: 10% -180% 10% auto;
    width: 80px;
    background: inherit;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .beam {
      animation: cta-drift 22s var(--ease-in-out) infinite alternate;
    }
  }
  @keyframes cta-drift {
    from {
      transform: translate3d(-18vw, 0, 0) skewX(-8deg);
    }
    to {
      transform: translate3d(14vw, 0, 0) skewX(-16deg);
    }
  }
  .inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  h2 {
    color: var(--night-ink);
    max-width: 16ch;
  }
  p {
    color: var(--night-muted);
    font-size: var(--text-lg);
    max-width: 52ch;
  }
  .band :global(.btn--primary) {
    --btn-shadow: var(--night-shadow);
    background: var(--night-brand);
    color: var(--night);
  }
  @media (hover: hover) and (pointer: fine) {
    .band :global(.btn--primary:hover) {
      background: var(--night-brand-hi);
    }
  }
  .band :global(:focus-visible) {
    outline-color: var(--night-brand);
  }
</style>
