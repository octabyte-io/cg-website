---
// The console tour on the home page: tabs over one large real screenshot.
// WAI-ARIA tabs with automatic activation: arrow keys, Home and End move between tabs, and the
// panel is one Tab stop away. Nothing turns by itself. Without JavaScript the tabs are not shown
// and every screenshot is listed in turn, each with its caption.
import ConsoleShot from './ConsoleShot.astro';
import type { TourStop } from '../data/tour';

interface Props {
  stops: TourStop[];
  label: string;
}
const { stops, label } = Astro.props;
const sizes = '(min-width: 1264px) 1200px, calc(100vw - 2rem)';
---
<div class="tour" data-tour>
  <div class="tour-tabs" role="tablist" aria-label={label}>
    {stops.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`tour-tab-${s.id}`}
        aria-controls={`tour-panel-${s.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >{s.label}</button>
    ))}
    <span class="tour-ink" aria-hidden="true"></span>
  </div>
  <div class="tour-stage">
    {stops.map((s) => (
      <div class="tour-panel" id={`tour-panel-${s.id}`} data-tab={`tour-tab-${s.id}`}>
        <h3 class="tour-title">{s.label}</h3>
        <ConsoleShot stop={s} sizes={sizes} crop />
        <div class="tour-cap">
          <p>{s.caption}</p>
          <a class="text-link" href={s.docs.href}>{s.docs.label}</a>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tour]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const ink = root.querySelector<HTMLElement>('.tour-ink')!;

    const placeInk = (tab: HTMLElement) => {
      ink.style.setProperty('--ink-x', `${tab.offsetLeft}px`);
      ink.style.setProperty('--ink-w', `${tab.offsetWidth}`);
    };

    // Fetch the screenshot a tab is about to show, in the theme on screen, before it is pressed.
    const warm = (i: number) => {
      const probe = root.querySelector('.cshot-pic--dark');
      const want = probe && getComputedStyle(probe).display === 'none' ? '.cshot-pic--light' : '.cshot-pic--dark';
      panels[i].querySelectorAll<HTMLImageElement>(`${want} img`).forEach((img) => (img.loading = 'eager'));
    };

    const select = (i: number, focus: boolean) => {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[n].hidden = !on;
      });
      const tab = tabs[i];
      if (focus) tab.focus({ preventScroll: true });
      placeInk(tab);
      // Keep the chosen tab in view inside a strip that scrolls sideways on phones.
      const left = tab.offsetLeft - list.clientWidth / 2 + tab.offsetWidth / 2;
      if (list.scrollWidth > list.clientWidth) list.scrollTo({ left, behavior: 'smooth' });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('pointerenter', () => warm(i));
      tab.addEventListener('focus', () => warm(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next < 0) return;
        e.preventDefault();
        select(next, true);
      });
    });

    // The panels become tab panels only now; without this script they are plain sections.
    panels.forEach((p, n) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', p.dataset.tab!);
      p.tabIndex = 0;
      p.hidden = n !== 0;
    });
    root.dataset.ready = '';
    placeInk(tabs[0]);
    new ResizeObserver(() => placeInk(tabs.find((t) => t.tabIndex === 0) ?? tabs[0])).observe(list);
  }
</script>

<style>
  .tour {
    display: grid;
    gap: var(--space-5);
  }

  /* Tabs: only with JavaScript. Without it every panel shows, one after another. */
  .tour-tabs {
    display: none;
  }
  :global(.js) .tour-tabs {
    position: relative;
    display: flex;
    gap: var(--space-1);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-padding-inline: var(--space-4);
  }
  :global(.js) .tour-tabs::-webkit-scrollbar {
    display: none;
  }
  .tour-tabs button {
    flex: none;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--text-md);
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tour-tabs button[aria-selected='true'] {
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .tour-tabs button:hover {
      color: var(--ink);
    }
  }
  .tour-tabs button:focus-visible {
    outline-offset: -3px;
  }
  /* The ink under the chosen tab: a 1px-wide bar moved and stretched, so it never lays out. */
  .tour-ink {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;
    height: 2px;
    background: var(--brand);
    transform-origin: left center;
    transform: translateX(var(--ink-x, 0)) scaleX(var(--ink-w, 0));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tour-ink {
      transition: transform 260ms var(--ease-out);
    }
  }

  .tour-panel {
    display: grid;
    gap: var(--space-4);
    border-radius: var(--radius-md);
  }
  .tour-panel + .tour-panel {
    margin-top: var(--space-7);
  }
  .tour-panel[hidden] {
    display: none;
  }
  /* Until the script has run, show only the first screenshot, so the section does not jump. */
  :global(.js) .tour:not([data-ready]) .tour-panel:not(:first-child) {
    display: none;
  }
  :global(.js) .tour-panel + .tour-panel {
    margin-top: 0;
  }
  /* The heading names each screenshot when the tabs are not there to. */
  .tour-title {
    font-size: var(--text-xl);
  }
  :global(.js) .tour-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tour[data-ready] .tour-panel:not([hidden]) {
      animation: tour-in 240ms var(--ease-out);
    }
  }
  @keyframes tour-in {
    from {
      opacity: 0.4;
    }
  }

  .tour-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
  }
  .tour-cap p {
    max-width: 68ch;
    color: var(--muted);
  }
  .tour-cap a {
    flex: none;
  }
</style>
