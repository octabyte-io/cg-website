---
import { templatesHome } from '../data/template-links';
import Mark from './Mark.astro';
import { site } from '../data/site';

const nav = [
  { href: '/ai-agents', label: 'AI agents' },
  { href: '/vibe-coding', label: 'Vibe coding' },
  { href: '/features', label: 'Features' },
  { href: templatesHome, label: 'Templates' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/self-hosted', label: 'Self-host' },
  { href: '/docs', label: 'Docs' },
];
const here = Astro.url.pathname.replace(/\.html$/, '');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Cloudgate home">
      <Mark size={34} />
      <span>Cloudgate</span>
    </a>
    <nav aria-label="Main" class="wide">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="end">
      <button class="theme" type="button" aria-label="Switch between light and dark theme" title="Switch theme">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></g></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8Z" /></svg>
      </button>
      <a class="signin" href={site.signIn}>Sign in</a>
      <a class="btn btn--primary" href={site.signUp}>Start free trial</a>
      <details class="menu">
        <summary><span class="when-shut">Menu</span><span class="when-open">Close</span></summary>
        <nav aria-label="Main, small screens">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
            <li><a href={site.signIn}>Sign in</a></li>
            <li class="menu-trial"><a href={site.signUp}>Start free trial</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // The switch flips between light and dark and remembers the choice; without one the site follows the system.
  const button = document.querySelector<HTMLButtonElement>('.site-header .theme');
  const current = () =>
    document.documentElement.dataset.theme ??
    (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  button?.addEventListener('click', () => {
    const next = current() === 'light' ? 'dark' : 'light';
    // Flip every colour in the same frame: no element may trail on its own hover transition.
    const root = document.documentElement;
    root.classList.add('theme-switching');
    root.dataset.theme = next;
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
    // Keep the phone's status bar and browser chrome in step with the page.
    const paper = next === 'light' ? '#f7f6fb' : '#0b0912';
    document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', paper));
    try {
      localStorage.setItem('cg-theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 64px;
  }
  .brand {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .wide {
    flex: 1;
  }
  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--paper-2);
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--ink);
      background: var(--paper-2);
    }
  }
  .end {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }
  .theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out);
  }
  /* The same give under the finger as every .btn. */
  .theme:active,
  .menu summary:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .theme:hover {
      background: var(--paper-2);
    }
  }
  /* Show the theme you would switch to. */
  .theme .moon {
    display: none;
  }
  :global(:root[data-theme='light']) .theme .sun {
    display: none;
  }
  :global(:root[data-theme='light']) .theme .moon {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .theme .sun {
      display: none;
    }
    :global(:root:not([data-theme='dark'])) .theme .moon {
      display: block;
    }
  }
  .signin {
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .signin:hover {
      color: var(--ink);
    }
  }
  .menu {
    display: none;
  }
  .menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
    transition: transform var(--dur-press) var(--ease-out);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] summary {
    background: var(--paper-2);
  }
  .menu .when-open,
  .menu[open] .when-shut {
    display: none;
  }
  .menu[open] .when-open {
    display: inline;
  }
  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 64px;
    padding: var(--space-3) max(var(--gutter), env(safe-area-inset-right, 0px)) var(--space-5)
      max(var(--gutter), env(safe-area-inset-left, 0px));
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 40px -24px var(--glow);
    /* A phone in landscape is shorter than the list: scroll inside the panel, never the page. */
    max-height: calc(100svh - 64px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* The panel drops in from under the header so it doesn't teleport; closing stays instant. */
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] nav {
      animation: menu-in 180ms var(--ease-out) both;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .menu ul {
    flex-direction: column;
  }
  .menu a {
    font-size: var(--text-md);
    padding: 0.75rem 0.5rem;
  }

  /* Below this the six links no longer fit on one line beside the actions. */
  @media (max-width: 1160px) {
    .wide,
    .signin {
      display: none;
    }
    .menu {
      display: block;
    }
    .end {
      gap: var(--space-3);
    }
  }
  @media (max-width: 480px) {
    .brand span {
      display: none;
    }
  }
  /* The smallest phones: the mark, the switch, the trial and the menu still fit on one line. */
  @media (max-width: 360px) {
    .bar,
    .end {
      gap: var(--space-2);
    }
    .end .btn {
      padding-inline: 0.8rem;
      white-space: nowrap;
    }
  }
  /* Narrower still, the trial button moves into the menu rather than squeezing the mark. */
  .menu-trial {
    display: none;
  }
  @media (max-width: 350px) {
    .end > .btn {
      display: none;
    }
    .menu .menu-trial {
      display: block;
    }
    .menu-trial a {
      color: var(--brand);
      font-weight: 600;
    }
  }
</style>
