---
// Every page's <head> metadata: title, description, canonical, Open Graph, Twitter and JSON-LD.
import { site } from '../data/site';
import { cardText, ogImagePath, OG_DEFAULT } from '../og/og.mjs';
import { lastmodOf } from '../data/lastmod.mjs';

interface Props {
  title: string;
  description: string;
  /** Path of the Open Graph image, 1200x630. Default: the page's own card, drawn at build time
   * (src/og/og.mjs); the home page and noindex pages use public/og/default.png. */
  image?: string;
  /** Alt text for the Open Graph image. Default: the text on the page's card. */
  imageAlt?: string;
  /** Extra JSON-LD objects for this page (FAQPage, BreadcrumbList, HowTo...). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** The day the page's content last changed (ISO date), when the page states one itself (a blog
   * post's `updated`). Default: the date of the last commit to the page's files. */
  modified?: string;
  /** 'article' on a blog post; 'website' everywhere else. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  image,
  imageAlt,
  schema = [],
  noindex = false,
  modified: ownModified,
  ogType = 'website',
} = Astro.props;

// build.format 'file' + trailingSlash 'never': pages are served as /x from x.html, and the home page
// is index.html. Astro.url.pathname can be '/x.html', '/x', '/index.html' or '/index' depending on
// the route, so normalise all of them to the public URL: '/', or '/x' with no slash and no '.html'.
const path = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/(^|\/)index$/, '$1')
  .replace(/\/+$/, '');
const canonical = new URL(path || '/', site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
// Each indexable page shares its own card: its title, under its breadcrumb section.
const ownCard = !image && !noindex && path !== '';
const imagePath = image ?? (ownCard ? ogImagePath(path) : OG_DEFAULT);
const crumbs = schema.find((s) => s['@type'] === 'BreadcrumbList') as
  | { itemListElement: { name: string }[] }
  | undefined;
const imageText =
  imageAlt ??
  (ownCard
    ? cardText(fullTitle, crumbs?.itemListElement.map((i) => i.name)).alt
    : 'Cloudgate: deploy apps, databases and AI models to servers and cloud accounts you own');
const imageUrl = new URL(imagePath, site.url).href;

const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/cloudgate-mark.png`,
  email: site.support,
  parentOrganization: { '@type': 'Organization', name: site.company.name, url: site.company.url },
  sameAs: [site.sourceUrl, site.npm, site.templatesRepo],
};
const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description: site.description,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'en',
};
const breadcrumb = schema.find((s) => s['@type'] === 'BreadcrumbList');
// The date of the last commit to the page's files, the same date the sitemap's <lastmod> carries.
const modified = noindex ? undefined : (ownModified ?? lastmodOf(path || '/'));
const webpage = noindex
  ? null
  : {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#organization` },
      primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl, width: 1200, height: 630 },
      inLanguage: 'en',
      ...(modified ? { dateModified: modified } : {}),
      ...(breadcrumb ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    };
const pageSchema = schema.map((s) =>
  s['@type'] === 'BreadcrumbList' && !s['@id'] ? { '@id': `${canonical}#breadcrumb`, ...s } : s,
);
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...(webpage ? [webpage] : []), ...pageSchema],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageText} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageText} />

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Cloudgate changelog" href="/changelog.xml" />
<link rel="alternate" type="application/rss+xml" title="Cloudgate blog" href="/blog.xml" />
<link rel="alternate" type="text/plain" title="Cloudgate summary for AI assistants" href="/llms.txt" />
<link rel="alternate" type="text/plain" title="Cloudgate full text for AI assistants" href="/llms-full.txt" />

<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
