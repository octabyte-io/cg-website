---
// One "Cloudgate vs X" page: the short answer first, the table, when to choose either, the FAQ.
// The data is in src/data/compare.ts; each page under src/pages/compare/ passes one competitor.
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import { site } from '../data/site';
import { faqSchema, breadcrumbSchema } from '../data/schema';
import { competitors, cloudgateRow, rowLabels, type Competitor, type RowKey } from '../data/compare';

interface Props { c: Competitor }
const { c } = Astro.props;

const trail = [
  { name: 'Compare', path: '/compare' },
  { name: `vs ${c.name}`, path: `/compare/${c.id}` },
];
const keys = Object.keys(rowLabels) as RowKey[];
const others = competitors.filter((x) => x.id !== c.id);
const tableId = `table-${c.id}`;
---

<Base title={c.title} description={c.description} schema={[faqSchema(c.faq), breadcrumbSchema(trail)]}>
  <PageHero title={c.h1} lede={c.lede} trail={trail}>
    <a class="btn btn--primary" href={site.signUp}>Start free trial</a>
    <a class="btn btn--ghost" href={`#${tableId}`}>See the comparison</a>
    <figure class="where panel" slot="visual" aria-label={`Where your app runs: with Cloudgate on your Server, AWS or Google Cloud; with ${c.name} on ${c.theirPlace}`}>
      <p class="where-title">Where your app runs</p>
      <div class="lane">
        <span class="who who--us">Cloudgate</span>
        <span class="wire" aria-hidden="true"></span>
        <ul class="dests">
          <li><span class="slice"></span>Your Server</li>
          <li><span class="slice slice--2"></span>Your AWS</li>
          <li><span class="slice slice--3"></span>Your Google Cloud</li>
        </ul>
      </div>
      <div class="lane lane--them">
        <span class="who">{c.name}</span>
        <span class="wire" aria-hidden="true"></span>
        <ul class="dests">
          <li class="theirs">{c.theirPlace}</li>
        </ul>
      </div>
    </figure>
  </PageHero>

  <section class="section" aria-labelledby="answer-title">
    <div class="wrap split">
      <div class="section-head" data-reveal>
        <h2 id="answer-title">Cloudgate vs {c.name}: the short answer</h2>
      </div>
      <div class="answer prose" data-reveal data-reveal-delay="120">
        {c.answer.map((p, i) => <p class:list={{ first: i === 0 }}>{p}</p>)}
        <p class="note">
          {c.name} is described here in general terms that rarely change. Check its own site for
          current plans and limits before you decide.
        </p>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby={`${tableId}-title`} id={tableId}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id={`${tableId}-title`}>How do Cloudgate and {c.name} compare?</h2>
        <p class="lede">
          The questions that decide it: whose machines, what it costs as you grow, and how far an AI
          agent can reach.
        </p>
      </div>
      <div class="table-wrap vs-wrap" role="region" aria-labelledby={`${tableId}-title`} tabindex="0" data-reveal>
        <table class="table vs">
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="col-us">Cloudgate</th>
              <th scope="col">{c.name}</th>
            </tr>
          </thead>
          <tbody>
            {keys.map((k) => (
              <tr>
                <th scope="row">{rowLabels[k]}</th>
                <td class="col-us" data-label="Cloudgate">{cloudgateRow[k]}</td>
                <td data-label={c.name}>{c.row[k]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="more">
        The Cloudgate column is checked against the product. See <a href="/pricing">Cloudgate’s
        plans and prices</a>, <a href="/features">everything Cloudgate deploys and runs</a>, and
        {' '}<a href="/ai-agents">how AI agents connect over MCP</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="choose-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="choose-title">When should you choose {c.name} instead?</h2>
        <p class="lede">Honestly, sometimes you should. And sometimes Cloudgate fits better.</p>
      </div>
      <div class="choose" data-reveal-stagger="90">
        <div class="side">
          <h3>Choose {c.name} if</h3>
          <ul class="ticks">
            {c.chooseThem.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="side panel" data-spotlight>
          <h3>Choose Cloudgate if</h3>
          <ul class="ticks ticks--us">
            {c.chooseUs.map((t) => <li set:html={t.replace(/`([^`]+)`/g, '<code>$1</code>')} />)}
          </ul>
          <p class="caveat">
            Worth knowing: Cloudgate is young. Its command-line tool is still a beta on npm, and the
            Servers you connect are yours to keep updated. Read <a href="/changelog">what changed
            recently</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Faq items={c.faq} title={`Cloudgate vs ${c.name}: questions people ask`} />

  <section class="section section--tight" aria-labelledby="others-title">
    <div class="wrap">
      <h2 id="others-title" class="others-title">Other comparisons</h2>
      <ul class="others" data-reveal-stagger>
        {others.map((o) => (
          <li>
            <a href={`/compare/${o.id}`} data-spotlight>
              <strong>Cloudgate vs {o.name}</strong>
              <span>{o.summary}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="/compare" data-spotlight>
            <strong>All comparisons</strong>
            <span>Cloudgate beside Heroku, Vercel, Render and Coolify in one table.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title={`Try Cloudgate beside ${c.name}`}
    text="Start the 30-day free trial, connect one server or cloud account, and deploy the same app to both. Or self-host Cloudgate for free."
  />
</Base>

<style>
  .where {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  .where-title {
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0;
  }
  .lane {
    display: grid;
    grid-template-columns: auto minmax(1.5rem, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
  }
  .lane--them {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .who {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .who--us {
    color: var(--brand);
    border-color: var(--brand);
    background: var(--brand-tint);
  }
  .wire {
    height: 1px;
    background: linear-gradient(90deg, var(--line-strong), var(--brand));
  }
  .lane--them .wire {
    background: var(--line-strong);
  }
  .dests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .dests li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  .dests .theirs {
    color: var(--muted);
  }

  .answer .first {
    font-size: var(--text-lg);
    color: var(--ink);
  }

  .vs-wrap {
    background: var(--surface);
  }
  .vs thead th {
    width: 38%;
  }
  .vs tbody th[scope='row'] {
    width: 24%;
  }
  .vs thead th.col-us {
    box-shadow: inset 0 3px 0 var(--brand);
    color: var(--brand);
  }
  .vs .col-us {
    background: color-mix(in srgb, var(--brand-tint) 45%, transparent);
    color: var(--ink);
  }

  .choose {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: start;
  }
  .side:not(.panel) {
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .side h3 {
    margin-bottom: var(--space-4);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .ticks li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink-2);
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.45em;
    width: 0.75rem;
    height: 0.4rem;
    border-left: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(-45deg);
  }
  .ticks--us li::before {
    border-color: var(--live);
  }
  .caveat {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .others-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }
  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }
  .others a {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .others a:hover {
      border-color: var(--line-strong);
    }
  }
  .others strong {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--brand);
  }
  .others span {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .choose {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .side:not(.panel) {
      padding: var(--space-5);
    }
    /* The table becomes one block per question, each answer labelled. */
    .vs,
    .vs tbody,
    .vs tr,
    .vs th,
    .vs td {
      display: block;
      width: auto !important;
    }
    .vs thead {
      display: none;
    }
    .vs tr {
      border-bottom: 1px solid var(--line);
      padding-block: var(--space-2);
    }
    .vs tbody tr:last-child {
      border-bottom: 0;
    }
    .vs th,
    .vs td {
      border-bottom: 0;
      padding-block: var(--space-2);
    }
    .vs tbody th[scope='row'] {
      font-family: var(--font-display);
      font-weight: 600;
    }
    .vs td::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 0.15rem;
    }
    .vs td.col-us::before {
      color: var(--brand);
    }
    .lane {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .wire {
      display: none;
    }
  }
</style>
