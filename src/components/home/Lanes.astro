---
// One Cloudgate, three places to run: a diagram of the gate sending work down three lanes.
// The dashes flow once the page loads; reduced motion keeps them still.
import Mark from '../Mark.astro';

interface Lane { slice: string; name: string; text: string; runs: string[] }
interface Props { lanes: Lane[] }
const { lanes } = Astro.props;
---
<div class="lanes-wrap">
  <div class="diagram" aria-hidden="true">
    <div class="gate">
      <Mark size={64} />
      <span>Cloudgate</span>
    </div>
    <svg viewBox="0 0 1200 160" preserveAspectRatio="none" class="wires">
      <path class="wire w1" d="M600 0 C 600 80, 200 70, 200 160" />
      <path class="wire w2" d="M600 0 L 600 160" />
      <path class="wire w3" d="M600 0 C 600 80, 1000 70, 1000 160" />
    </svg>
  </div>
  <div class="lanes">
    {lanes.map((lane, i) => (
      <article class="lane panel">
        <div class="lane-head">
          <span class:list={['slice', lane.slice]} aria-hidden="true"></span>
          <h3>{lane.name}</h3>
        </div>
        <p>{lane.text}</p>
        <ul>{lane.runs.map((r) => <li>{r}</li>)}</ul>
      </article>
    ))}
  </div>
</div>

<style>
  .diagram {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .gate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: 0 0 60px -10px var(--glow);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    position: relative;
    z-index: 1;
  }
  .wires {
    width: 100%;
    height: 120px;
    overflow: visible;
  }
  .wire {
    fill: none;
    stroke-width: 2;
    stroke-dasharray: 6 10;
    vector-effect: non-scaling-stroke;
    animation: flow 1.6s linear infinite;
  }
  .w1 {
    stroke: var(--slice-1);
  }
  .w2 {
    stroke: var(--slice-2);
  }
  .w3 {
    stroke: var(--slice-3);
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -32;
    }
  }
  .lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .lane {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }
  .lane-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lane p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .lane ul {
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .lane li {
    display: flex;
    gap: var(--space-2);
  }
  .lane li::before {
    content: '';
    flex: none;
    margin-top: 0.55em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--brand);
  }
  @media (max-width: 900px) {
    .wires {
      display: none;
    }
    .diagram {
      margin-bottom: var(--space-5);
    }
    .lanes {
      grid-template-columns: 1fr;
    }
  }
</style>
