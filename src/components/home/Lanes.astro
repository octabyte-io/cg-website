---
// One Cloudgate, three places to run: a diagram of the gate sending work down three lanes.
// The dashes flow, a packet of light runs down each wire and the gate breathes; reduced motion
// keeps all of it still.
import Mark from '../Mark.astro';

interface Lane { slice: string; name: string; text: string; runs: string[] }
interface Props { lanes: Lane[] }
const { lanes } = Astro.props;
---
<div class="lanes-wrap">
  <div class="diagram" aria-hidden="true" data-reveal data-play>
    <div class="gate">
      <Mark size={64} />
      <span>Cloudgate</span>
    </div>
    <svg viewBox="0 0 1200 160" preserveAspectRatio="none" class="wires">
      <path class="wire w1" d="M600 0 C 600 80, 200 70, 200 160" />
      <path class="wire w2" d="M600 0 L 600 160" />
      <path class="wire w3" d="M600 0 C 600 80, 1000 70, 1000 160" />
      <g class="packets">
        <path class="packet p1" d="M600 0 C 600 80, 200 70, 200 160" pathLength="100" />
        <path class="packet p2" d="M600 0 L 600 160" pathLength="100" />
        <path class="packet p3" d="M600 0 C 600 80, 1000 70, 1000 160" pathLength="100" />
      </g>
    </svg>
  </div>
  <div class="lanes" data-reveal-stagger="90">
    {lanes.map((lane, i) => (
      <article class="lane panel" data-spotlight>
        <div class="lane-head">
          <span class:list={['slice', lane.slice]} aria-hidden="true"></span>
          <h3>{lane.name}</h3>
        </div>
        <p>{lane.text}</p>
        <ul>{lane.runs.map((r) => <li>{r}</li>)}</ul>
      </article>
    ))}
  </div>
</div>

<style>
  .diagram {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .gate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: 0 0 60px -10px var(--glow);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    position: relative;
    z-index: 1;
  }
  .wires {
    width: 100%;
    height: 120px;
    overflow: visible;
  }
  .wire {
    fill: none;
    stroke-width: 2;
    stroke-dasharray: 6 10;
    vector-effect: non-scaling-stroke;
  }
  /* A short bright dash with a soft halo, travelling the length of its wire. */
  .packet {
    fill: none;
    stroke: var(--brand-hi);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 4 200;
    stroke-dashoffset: 4;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    filter: drop-shadow(0 0 4px var(--brand));
  }
  .gate::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow: 0 0 70px 0 var(--glow), 0 0 0 1px var(--brand);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Calm, and only once the diagram is in view (not from page load, off screen). */
    .is-playing .wire {
      animation: flow 3.2s linear infinite;
    }
    .is-playing .packet {
      animation: packet 3.6s var(--ease-in-out) infinite;
    }
    .is-playing .p2 {
      animation-delay: 1.2s;
    }
    .is-playing .p3 {
      animation-delay: 2.4s;
    }
    .is-playing .gate::after {
      animation: gate-glow 3.6s var(--ease-in-out) infinite;
    }
  }
  @keyframes packet {
    0% {
      stroke-dashoffset: 4;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    85%,
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }
  @keyframes gate-glow {
    50% {
      opacity: 0.6;
    }
  }
  .w1 {
    stroke: var(--slice-1);
  }
  .w2 {
    stroke: var(--slice-2);
  }
  .w3 {
    stroke: var(--slice-3);
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -32;
    }
  }
  .lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .lane {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }
  .lane-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lane p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .lane ul {
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .lane li {
    display: flex;
    gap: var(--space-2);
  }
  .lane li::before {
    content: '';
    flex: none;
    margin-top: 0.55em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--brand);
  }
  @media (max-width: 900px) {
    .wires {
      display: none;
    }
    .diagram {
      margin-bottom: var(--space-5);
    }
    .lanes {
      grid-template-columns: 1fr;
    }
  }
</style>
