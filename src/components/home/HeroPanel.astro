---
// The hero's three ways in, one per slice of the mark. A radio group drives the panels with CSS
// alone, so it works without JavaScript and each panel stays in the HTML for crawlers.
//
// With JavaScript, and unless the visitor asked for reduced motion, the panel plays itself while it
// is on screen: it steps through the three tabs, and each one acts out its own run (the wizard ticks
// its steps, the transcript and terminal print line by line). The first click on or focus of a tab
// stops that for good and shows every pane in its final state, the same as without JavaScript.
---
<div class="panel" role="group" aria-label="Three ways to deploy with Cloudgate" data-hero-panel>
  <div class="tabs">
    <span class="ind" aria-hidden="true"></span>
    <input type="radio" name="way" id="way-console" checked />
    <label for="way-console"><span class="slice"></span><span class="txt" data-text="In the console">In the console</span></label>
    <input type="radio" name="way" id="way-agent" />
    <label for="way-agent"><span class="slice slice--2"></span><span class="txt" data-text="From your AI agent">From your AI agent</span></label>
    <input type="radio" name="way" id="way-cli" />
    <label for="way-cli"><span class="slice slice--3"></span><span class="txt" data-text="From your terminal">From your terminal</span></label>

    <section class="pane pane--console" aria-label="Deploying a template in the console">
      <div class="window" data-wizard>
        <div class="pane-body">
        <p class="win-title">Get started: deploy n8n</p>
        <ol class="checklist">
          <li class="done"><span>Your account</span><span class="state">Signed in</span></li>
          <li class="done">
            <span>A server</span>
            <span class="state">Bought from Cloudgate, 2 vCPU, 4 GB</span>
          </li>
          <li class="current">
            <span>Deploy</span>
            <span class="state live" data-running>Running</span>
            <span class="state building" data-building hidden>Building<span class="bar"><span></span></span></span>
          </li>
        </ol>
        <div class="result">
          <p>n8n is online at</p>
          <p class="url">http://n8n-app.203-0-113-24.sslip.io</p>
          <p class="hint">Next: add your own domain for https.</p>
        </div>
        </div>
      </div>
    </section>

    <section class="pane pane--agent" aria-label="An AI agent deploying over MCP">
      <pre class="code" data-typed="you"><code class="pane-body"><span class="d">you</span>    Fix the checkout bug and send me a preview.
<span class="d">agent</span>  Pushed fix-checkout. Asking Cloudgate for a preview.

<span class="k">create_preview</span>  {'{'} applicationId: <span class="s">"shop-web"</span>, branch: <span class="s">"fix-checkout"</span> {'}'}
<span class="d">→</span> queued, expires in 60 minutes

<span class="k">read_deployment_log</span>  {'{'} deploymentId: <span class="s">"dpl_4f2c"</span> {'}'}
<span class="d">→</span> build finished, container healthy
<span class="d">→</span> DATABASE_URL=<span class="s">••••••</span>

<span class="k">get_service_health</span>  {'{'} serviceId: <span class="s">"shop-web"</span> {'}'}
<span class="d">→</span> uptime check up, error rate under threshold

<span class="d">agent</span>  Preview is live. Every call above is in your audit log.</code></pre>
    </section>

    <section class="pane pane--cli" aria-label="Deploying a folder from the terminal">
      <pre class="code" data-typed="$"><code class="pane-body"><span class="d">$</span> npm install -g @octabyte-io/cloudgate@next
<span class="d">$</span> cloudgate login
<span class="d">  Approve code</span> <span class="s">QXRT-7PLM</span> <span class="d">in the console</span>
<span class="d">$</span> cd my-app
<span class="d">$</span> <span class="k">cloudgate deploy</span>
<span class="d">  Uploading 214 files (skipping .env and .git)</span>
<span class="d">  Building with Nixpacks</span>
<span class="d">  Deployment</span> <span class="s">done</span>
<span class="d">$</span> cloudgate logs --follow</code></pre>
    </section>
  </div>
</div>

<style>
  .panel {
    padding: var(--space-3);
  }
  .tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, auto) 1fr;
    gap: var(--space-1);
  }
  /* The active tab's fill. Without JavaScript each label paints its own; with it, one fill slides
     between the tabs by its clip (the script sets the --ind-* insets), so it never pops. */
  .ind {
    display: none;
    position: absolute;
    inset: 0 0 auto;
    height: var(--ind-h, 44px);
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    pointer-events: none;
    clip-path: inset(
      var(--ind-t, 0) var(--ind-r, 100%) var(--ind-b, 0) var(--ind-l, 0) round var(--radius-sm)
    );
  }
  .tabs:global(.has-ind) .ind {
    display: block;
  }
  .tabs:global(.has-ind.ind-ready) .ind {
    transition: clip-path 260ms var(--ease-in-out);
  }
  .tabs:global(.has-ind) input:checked + label {
    background: transparent;
  }
  /* The label holds the width of its bold self, so turning active never nudges its neighbours. */
  .txt {
    display: inline-grid;
  }
  .txt::after {
    content: attr(data-text);
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 500;
  }
  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--muted);
    cursor: pointer;
    user-select: none;
    transition:
      background-color 150ms var(--ease),
      color 150ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    label:hover {
      color: var(--ink);
    }
  }
  input:checked + label {
    background: var(--paper-2);
    color: var(--ink);
    font-weight: 500;
  }
  input:focus-visible + label {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  /* While the panel plays itself: time left on the current tab. A still track (::before) and a
     fill (::after) that grows by transform, so the bar never repaints while it runs. */
  .tabs:global(.timing) input:checked + label::before,
  .tabs:global(.timing) input:checked + label::after {
    content: '';
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 5px;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--brand) 16%, transparent);
  }
  .tabs:global(.timing) input:checked + label::after {
    background: var(--brand);
    transform-origin: left;
    animation:
      tab-time var(--dwell, 6s) linear both,
      bar-in 240ms var(--ease-out) 120ms both;
  }
  .tabs:global(.timing) input:checked + label::before {
    animation: bar-in 240ms var(--ease-out) 120ms both;
  }
  @keyframes tab-time {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes bar-in {
    from {
      opacity: 0;
    }
  }

  /* ---- Switching panes: a crossfade in one grid cell ----
     Every pane sits in the same cell, so the stage is always as tall as the tallest pane and a
     switch never changes the panel's height. The incoming pane (on top) fades its window in over
     the outgoing one, whose window stays drawn underneath until it is covered: the stage is never
     empty, and two dark terminals never dip to the panel's colour between them. Inside, the old
     content drifts up 4px and fades (200ms; its fade on ease-in-out, so it is still half there
     when the new content arrives) while the new content rises 6px in (280ms, 60ms later). No
     blur on the way out: blurring a whole terminal cost about three frames a switch. All
     transitions sit on :checked, so rapid clicks retarget from where things are. The exit drift
     uses `translate` and the entry rise `transform`, so a pane that has left resets to its entry
     position (once hidden) without a second class. */
  .pane {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    margin-top: var(--space-2);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0s linear 360ms,
      visibility 0s linear 360ms;
  }
  #way-console:checked ~ .pane--console,
  #way-agent:checked ~ .pane--agent,
  #way-cli:checked ~ .pane--cli {
    z-index: 1;
    visibility: visible;
    opacity: 1;
    transition:
      opacity 240ms var(--ease-out),
      visibility 0s;
  }
  .pane-body {
    opacity: 0;
    translate: 0 -4px;
    transform: translateY(6px);
    transition:
      opacity 200ms var(--ease-in-out),
      translate 200ms var(--ease-out),
      transform 0s linear 360ms;
  }
  #way-console:checked ~ .pane--console .pane-body,
  #way-agent:checked ~ .pane--agent .pane-body,
  #way-cli:checked ~ .pane--cli .pane-body {
    opacity: 1;
    translate: none;
    transform: none;
    transition:
      opacity 280ms var(--ease-out) 60ms,
      transform 280ms var(--ease-out) 60ms,
      translate 0s;
  }
  /* Reduced motion: no drift, no delay; the new pane fades in quickly over the old one. */
  @media (prefers-reduced-motion: reduce) {
    .pane-body,
    #way-console:checked ~ .pane--console .pane-body,
    #way-agent:checked ~ .pane--agent .pane-body,
    #way-cli:checked ~ .pane--cli .pane-body {
      translate: none;
      transform: none;
      transition: opacity 150ms var(--ease-out);
    }
    #way-console:checked ~ .pane--console,
    #way-agent:checked ~ .pane--agent,
    #way-cli:checked ~ .pane--cli {
      transition: opacity 150ms var(--ease-out);
    }
  }
  .pane .code {
    min-height: 330px;
    white-space: pre;
  }
  code.pane-body {
    display: block;
  }

  .window {
    min-height: 330px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-md) - 4px);
    background: var(--paper);
    padding: var(--space-5);
  }
  .window > .pane-body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  /* Playing starts while the pane is hidden: its first frame must already be the playing state. */
  .window:global(.instant),
  .window:global(.instant) * {
    transition: none !important;
  }
  .win-title {
    font-weight: 600;
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: var(--space-2);
  }
  .checklist li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: var(--text-sm);
    transition:
      border-color 300ms var(--ease),
      opacity 300ms var(--ease);
  }
  .checklist li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand);
    font-weight: 600;
    font-size: var(--text-xs);
  }
  .checklist li.done::before {
    content: '✓';
  }
  .checklist li.current {
    border-color: var(--brand);
  }
  .state {
    color: var(--muted);
    text-align: right;
    transition: opacity 300ms var(--ease);
  }
  .state.live {
    color: var(--live);
  }
  .building {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
  }
  .state[hidden] {
    display: none;
  }
  .bar {
    width: 4.5rem;
    height: 4px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--brand-tint);
  }
  .bar > span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--beam-a), var(--brand));
    transform-origin: left;
    animation: build 1.9s var(--ease-in-out) both;
  }
  @keyframes build {
    from {
      transform: scaleX(0.04);
    }
  }
  .result {
    border-top: 1px dashed var(--line-strong);
    padding-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
  }
  .url {
    font-family: var(--font-mono);
    color: var(--ink);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
    margin-block: var(--space-1);
  }
  .hint {
    font-size: var(--text-xs);
  }

  /* ---- The wizard acting out a run (set by the script below) ---- */
  .window:global(.playing) li:not(:global(.ticked)):not(:global(.building)) {
    opacity: 0.5;
    border-color: var(--line);
  }
  .window:global(.playing) li:not(:global(.ticked))::before {
    content: counter(step);
  }
  .window:global(.playing) li:not(:global(.ticked)) .state:not(.building) {
    opacity: 0;
  }
  .window:global(.playing) li:global(.ticked)::before {
    animation: tick 400ms var(--ease-out) both;
  }
  .window:global(.playing) li:global(.building)::before {
    content: '';
    box-sizing: border-box;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.25rem;
    background: transparent;
    border: 2px solid var(--brand-tint);
    border-top-color: var(--brand);
    animation: spin 800ms linear infinite;
  }
  .window:global(.playing):not(:global(.finished)) .result {
    opacity: 0;
    transform: translateY(8px);
  }
  /* The same pop as the bento's dots: from half size, a small overshoot, never from nothing. */
  @keyframes tick {
    from {
      transform: scale(0.5);
      opacity: 0;
    }
    60% {
      transform: scale(1.12);
      opacity: 1;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* ---- The transcript and terminal printing line by line ---- */
  .code:global(.playing) :global(.ln:not(.on)) {
    visibility: hidden;
  }
  .code :global(.ln.on:not(.typed)) {
    animation: line-in 260ms var(--ease-out) both;
  }
  .code :global(.ln.typing) {
    display: inline-block;
    vertical-align: top;
    overflow: hidden;
    white-space: pre;
    width: 0;
    animation: type var(--type, 600ms) steps(var(--steps, 20), end) var(--wait, 0ms) both;
  }
  .code :global(.caret) {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--night-brand);
    animation: blink 1s steps(1, end) infinite;
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
  }
  /* From the prompt (shown the moment the line appears), out to the whole line. */
  @keyframes type {
    from {
      width: calc(var(--p, 0) * 1ch);
    }
    to {
      width: calc(var(--n, 20) * 1ch);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .tabs {
      grid-template-columns: 1fr;
    }
    .pane {
      grid-row: 4;
    }
    .checklist li {
      grid-template-columns: 1.75rem 1fr;
    }
    .state {
      grid-column: 2;
      text-align: left;
    }
    .building {
      justify-content: flex-start;
    }
    .pane .code {
      font-size: var(--text-xs);
      min-height: 0;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-panel]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // One fill for the active tab, slid between the tabs by its clip (see .ind). Runs with or without
  // reduced motion; under reduced motion the clip simply snaps.
  if (root) {
    const tabs = root.querySelector<HTMLElement>('.tabs')!;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[name="way"]')];
    const labels = inputs.map((i) => root.querySelector<HTMLLabelElement>(`label[for="${i.id}"]`)!);
    const place = () => {
      const k = Math.max(0, inputs.findIndex((i) => i.checked));
      const l = labels[k];
      const h = Math.max(...labels.map((x) => x.offsetTop + x.offsetHeight));
      const w = tabs.clientWidth;
      tabs.style.setProperty('--ind-h', `${h}px`);
      tabs.style.setProperty('--ind-t', `${l.offsetTop}px`);
      tabs.style.setProperty('--ind-l', `${l.offsetLeft}px`);
      tabs.style.setProperty('--ind-r', `${w - l.offsetLeft - l.offsetWidth}px`);
      tabs.style.setProperty('--ind-b', `${h - l.offsetTop - l.offsetHeight}px`);
    };
    tabs.classList.add('has-ind');
    place();
    requestAnimationFrame(() => requestAnimationFrame(() => tabs.classList.add('ind-ready')));
    inputs.forEach((i) => i.addEventListener('change', place));
    // A resize (or the web font arriving) moves the tabs: follow without sliding.
    new ResizeObserver(() => {
      tabs.classList.remove('ind-ready');
      place();
      requestAnimationFrame(() => tabs.classList.add('ind-ready'));
    }).observe(tabs);
    (root as HTMLElement & { placeIndicator?: () => void }).placeIndicator = place;
  }

  if (root && !reduce.matches) {
    const tabs = root.querySelector<HTMLElement>('.tabs')!;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[name="way"]')];
    const labels = [...root.querySelectorAll<HTMLLabelElement>('label')];
    const place = (root as HTMLElement & { placeIndicator?: () => void }).placeIndicator!;
    const wizard = root.querySelector<HTMLElement>('[data-wizard]')!;
    const steps = [...wizard.querySelectorAll<HTMLLIElement>('.checklist li')];
    const running = wizard.querySelector<HTMLElement>('[data-running]')!;
    const building = wizard.querySelector<HTMLElement>('[data-building]')!;
    const caret = document.createElement('span');
    caret.className = 'caret';
    caret.setAttribute('aria-hidden', 'true');

    // Wrap each line of a <pre><code> in its own span, so lines can appear one at a time.
    const splitLines = (pre: HTMLElement) => {
      const code = pre.querySelector('code')!;
      const groups: Node[][] = [[]];
      for (const node of [...code.childNodes]) {
        if (node.nodeType !== Node.TEXT_NODE) {
          groups[groups.length - 1].push(node);
          continue;
        }
        (node.textContent ?? '').split('\n').forEach((part, i) => {
          if (i > 0) groups.push([]);
          if (part) groups[groups.length - 1].push(document.createTextNode(part));
        });
      }
      code.textContent = '';
      const prompt = pre.dataset.typed ?? '';
      return groups.map((nodes, i) => {
        const line = document.createElement('span');
        line.className = 'ln';
        line.append(...nodes);
        code.append(line);
        if (i < groups.length - 1) code.append('\n');
        const text = line.textContent ?? '';
        const typed = prompt !== '' && text.startsWith(prompt);
        // The prompt and the spaces after it show at once; only what follows is typed.
        const head = typed ? (text.match(/^\S+\s+/)?.[0].length ?? 0) : 0;
        return { el: line, text, typed, head };
      });
    };
    const transcripts = [...root.querySelectorAll<HTMLElement>('pre[data-typed]')].map((pre) => ({
      pre,
      lines: splitLines(pre),
    }));

    let timers: number[] = [];
    let current = Math.max(0, inputs.findIndex((i) => i.checked));
    let auto = true;
    let inView = false;
    let playing = false;

    // A step due now runs now, in the same frame as the tab switch, so the incoming pane's first
    // painted frame already shows its prompt (a timeout of 0 could let one empty frame through).
    const later = (ms: number, fn: () => void) => {
      if (ms <= 0) fn();
      else timers.push(window.setTimeout(fn, ms));
    };
    const clearTimers = () => {
      timers.forEach((t) => clearTimeout(t));
      timers = [];
    };

    // Every pane back to its final state: what a visitor without JavaScript sees.
    const settle = () => {
      wizard.classList.remove('playing', 'finished');
      steps.forEach((li) => li.classList.remove('ticked', 'building'));
      running.hidden = false;
      building.hidden = true;
      for (const { pre, lines } of transcripts) {
        pre.classList.remove('playing');
        lines.forEach(({ el }) => el.classList.remove('on', 'typing', 'typed'));
      }
      caret.remove();
    };

    // The labels show from the first frame (dimmed); only the ticks, the status and the result
    // play. `instant` puts a pane that is just coming in straight into that start state.
    const playWizard = (lead: number, instant: boolean) => {
      if (instant) wizard.classList.add('instant');
      wizard.classList.add('playing');
      if (instant) {
        void wizard.offsetWidth;
        wizard.classList.remove('instant');
      }
      const [account, server, deploy] = steps;
      later(lead + 250, () => account.classList.add('ticked'));
      later(lead + 800, () => server.classList.add('ticked'));
      later(lead + 1350, () => {
        deploy.classList.add('building');
        running.hidden = true;
        building.hidden = false;
      });
      later(lead + 3300, () => {
        deploy.classList.remove('building');
        deploy.classList.add('ticked');
        building.hidden = true;
        running.hidden = false;
      });
      later(lead + 3700, () => wizard.classList.add('finished'));
      return lead + 3700;
    };

    // The first line and its prompt show with the pane, a caret after them; typing starts 140ms
    // later, then each line follows in turn.
    const WAIT = 140;
    const playLines = (index: number, lead: number) => {
      const { pre, lines } = transcripts[index];
      pre.classList.add('playing');
      let at = lead;
      for (const line of lines) {
        const { el, text, typed, head } = line;
        if (!text.trim()) {
          at += 140;
          continue;
        }
        const typeMs = typed ? Math.min(1100, (text.length - head) * 24) : 0;
        later(at, () => {
          el.classList.add('on');
          if (typed) {
            el.style.setProperty('--n', String(text.length));
            el.style.setProperty('--p', String(head));
            el.style.setProperty('--steps', String(Math.max(1, text.length - head)));
            el.style.setProperty('--type', `${typeMs}ms`);
            el.style.setProperty('--wait', `${WAIT}ms`);
            el.classList.add('typing', 'typed');
          }
          el.after(caret);
        });
        if (typed) later(at + WAIT + typeMs + 20, () => el.classList.remove('typing'));
        at += typed ? WAIT + typeMs + 380 : 300;
      }
      return at;
    };

    const play = (index: number, lead = 0, switching = false) => {
      clearTimers();
      settle();
      current = index;
      const end = index === 0 ? playWizard(lead, switching) : playLines(index - 1, lead);
      const dwell = Math.max(6000, end + 1800);
      tabs.style.setProperty('--dwell', `${dwell - lead}ms`);
      tabs.classList.remove('timing');
      void tabs.offsetWidth; // restart the progress bar
      later(lead, () => tabs.classList.add('timing'));
      later(dwell, advance);
      playing = true;
    };

    // Leaving the screen never cuts a pane off halfway and restarts it later (that read as a stall
    // and a jump). The pane plays out; only the move to the next tab waits until the panel is back.
    let waiting = false;
    const advance = () => {
      if (!inView || document.hidden) {
        waiting = true;
        return;
      }
      waiting = false;
      const next = (current + 1) % inputs.length;
      inputs[next].checked = true;
      place();
      play(next, 0, true);
    };

    const update = () => {
      const should = auto && inView && !document.hidden && !reduce.matches;
      if (!should) return;
      if (!playing) play(current, Math.max(0, 1000 - performance.now()));
      else if (waiting) {
        waiting = false;
        later(500, advance);
      }
    };

    const pause = () => {
      clearTimers();
      tabs.classList.remove('timing');
      playing = false;
      waiting = false;
    };

    // The visitor took over: stop for good and show everything as it is. Panes are filled in once
    // the crossfade has carried the old one out, so it never jumps to its final state mid-exit.
    const takeOver = () => {
      if (!auto) return;
      auto = false;
      pause();
      window.setTimeout(settle, 360);
    };
    inputs.forEach((input) => {
      input.addEventListener('focus', takeOver);
      input.addEventListener('change', takeOver);
    });
    labels.forEach((label) => label.addEventListener('pointerdown', takeOver));
    reduce.addEventListener('change', takeOver);

    new IntersectionObserver(
      (entries) => {
        // Start once a fifth of the panel shows; count it as gone only when it has fully left.
        const e = entries[entries.length - 1];
        inView = playing ? e.isIntersecting : e.intersectionRatio >= 0.2;
        update();
      },
      { threshold: [0, 0.2] },
    ).observe(root);
    document.addEventListener('visibilitychange', update);
  }
</script>
