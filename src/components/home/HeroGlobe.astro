---
// The home hero's globe ("Beacons"): a dotted Earth with the Cloudgate mark at its centre and a
// handful of servers, each tagged with its lane (your own server, AWS, Google Cloud) in the slice
// tones. One deploy at a time leaves the mark, lands on a server facing the visitor, a short column
// of light rises from it, and a card turns from Deploying to Running. Few servers on purpose: the
// picture is "one Cloudgate, servers you bring", not a worldwide network.
//
// Decorative only (aria-hidden). It draws on a canvas, reads every colour from the theme tokens, and
// loads its land map (/globe/land.bin, Natural Earth 50m at 0.5°, one bit per cell) after the page
// has painted. It rests off screen and in hidden tabs. With reduced motion it is one still frame of
// a finished deploy; without JavaScript only the mark is shown.
import Mark from '../Mark.astro';
---
<div class="hero-globe" aria-hidden="true" data-hero-globe>
  <canvas></canvas>
  <div class="globe-hub"><Mark size={44} /></div>
  <ul class="globe-legend">
    <li><i class="slice"></i>Your server</li>
    <li><i class="slice slice--2"></i>AWS</li>
    <li><i class="slice slice--3"></i>Google Cloud</li>
  </ul>
</div>

<style>
  .hero-globe {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 1.04;
    justify-self: center;
  }
  .hero-globe canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
    cursor: grab;
  }
  .hero-globe canvas:active {
    cursor: grabbing;
  }
  .globe-hub {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    pointer-events: none;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow:
      inset 0 1px 0 var(--panel-top),
      0 0 0 6px color-mix(in srgb, var(--paper) 70%, transparent),
      0 12px 44px -10px var(--glow);
    /* Centred until the script places it on the globe's centre. */
    transform: translate(calc(var(--hx, 50cqw) - 38px), calc(var(--hy, 48cqh) - 38px));
  }
  .globe-hub::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1.5px solid var(--brand);
    opacity: 0;
  }
  .globe-hub.is-sending::after {
    animation: hub-send 900ms var(--ease-out);
  }
  @keyframes hub-send {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.45);
    }
  }
  .globe-legend {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 6px 14px;
    list-style: none;
    white-space: nowrap;
    font-size: var(--text-xs, 0.8rem);
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .globe-legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .globe-legend .slice {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--slice-1);
  }
  .globe-legend .slice--2 {
    background: var(--slice-2);
  }
  .globe-legend .slice--3 {
    background: var(--slice-3);
  }
  .hero-globe {
    container-type: size;
  }
  @media (max-width: 640px) {
    .globe-hub {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      transform: translate(calc(var(--hx, 50cqw) - 29px), calc(var(--hy, 48cqh) - 29px));
    }
    .globe-hub :global(svg) {
      width: 36px;
      height: auto;
    }
    .globe-legend {
      gap: var(--space-3);
      padding: 5px 10px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-globe canvas {
      animation: globe-in 1.1s var(--ease-out) 0.35s both;
    }
    .globe-hub {
      animation: hub-in 700ms var(--ease-out) 0.55s both;
    }
  }
  @keyframes globe-in {
    from {
      opacity: 0;
      transform: scale(0.965);
    }
  }
  @keyframes hub-in {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }
</style>

<script>
  type RGB = [number, number, number];
  type Pos = { x: number; y: number; z: number };
  interface Node {
    lane: number;
    wx: number;
    wy: number;
    wz: number;
  }
  interface Deploy {
    i: number;
    s: number;
    sent: boolean;
  }

  const D2R = Math.PI / 180;
  const TAU = Math.PI * 2;
  const LANES = ['Your server', 'AWS', 'Google Cloud'];
  // Illustrative places only; lane 0 your server, 1 AWS, 2 Google Cloud.
  const PLACES: [number, number, number][] = [
    [51.5, -0.1, 0],
    [40.7, -74.0, 1],
    [50.1, 8.7, 2],
    [1.35, 103.8, 1],
    [37.8, -122.4, 0],
  ];
  const NODES: Node[] = PLACES.map(([lat, lon, lane]) => ({
    lane,
    wx: Math.cos(lat * D2R) * Math.sin(lon * D2R),
    wy: Math.sin(lat * D2R),
    wz: Math.cos(lat * D2R) * Math.cos(lon * D2R),
  }));
  // A deploy: travel, then Deploying, then Running, then fade (ms).
  const T_TRAVEL = 1150;
  const T_BUILD = 1000;
  const T_RUN = 1900;
  const T_FADE = 450;
  const T_TOTAL = T_TRAVEL + T_BUILD + T_RUN + T_FADE;
  const TURN_MS = 150000; // one turn in 2.5 minutes

  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const rgba = (c: RGB, a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  function parse(v: string): RGB {
    const s = v.trim();
    const m = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(s);
    if (m) {
      const h = m[1].length === 3 ? [...m[1]].map((c) => c + c).join('') : m[1];
      const n = parseInt(h, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    const r = /rgba?\(([^)]+)\)/.exec(s);
    if (r) {
      const p = r[1].split(/[ ,/]+/).map(Number);
      return [p[0] || 0, p[1] || 0, p[2] || 0];
    }
    return [128, 128, 128];
  }

  function start(wrap: HTMLElement) {
    const canvas = wrap.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    const hub = wrap.querySelector<HTMLElement>('.globe-hub')!;
    if (!ctx) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    let land: Uint8Array | null = null;
    let pts = new Float32Array(0);
    let builtStep = 0;
    let w = 0, h = 0, dpr = 1, R = 0, cx = 0, cy = 0, gap = 6;
    let lambda = 0.35, vel = 0;
    const tilt = 18 * D2R;
    let visible = true, dragging = false, raf = 0, last = 0;
    let t0 = performance.now(), nextDep = t0 + 1600, lastI = -1;
    let dep: Deploy | null = null;
    let c = colors();
    let font = getComputedStyle(document.body).fontFamily;

    function colors() {
      const cs = getComputedStyle(document.documentElement);
      const g = (k: string) => parse(cs.getPropertyValue(k));
      return {
        brand: g('--brand'), muted: g('--muted'), ink: g('--ink'), line: g('--line'), paper: g('--paper'),
        surface: g('--surface'), live: g('--live'), peach: g('--beam-c'),
        lanes: [g('--slice-1'), g('--slice-2'), g('--slice-3')] as RGB[],
      };
    }
    const isLand = (lat: number, lon: number) => {
      if (!land) return false;
      const r = clamp(Math.floor((90 - lat) / 0.5), 0, 359);
      const col = Math.min(719, Math.floor((((lon + 180) % 360) + 360) % 360 / 0.5));
      const i = r * 720 + col;
      return ((land[i >> 3] >> (i & 7)) & 1) === 1;
    };
    function build() {
      const step = clamp(6.6 / (R * D2R), 0.9, 4);
      if (!land || Math.abs(step - builtStep) < 0.01) return;
      builtStep = step;
      gap = step * R * D2R;
      const out: number[] = [];
      for (let lat = -84; lat <= 84; lat += step) {
        const n = Math.max(1, Math.round((360 * Math.cos(lat * D2R)) / step));
        for (let k = 0; k < n; k++) {
          const lon = -180 + ((k + 0.5) * 360) / n;
          if (isLand(lat, lon)) out.push(Math.cos(lat * D2R), Math.sin(lat * D2R), Math.sin(lon * D2R), Math.cos(lon * D2R));
        }
      }
      pts = new Float32Array(out);
    }
    function resize() {
      const r = wrap.getBoundingClientRect();
      if (!r.width || !r.height) return;
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      R = Math.min(w, h) * 0.42; cx = w / 2; cy = h * 0.47;
      wrap.style.setProperty('--hx', `${cx}px`);
      wrap.style.setProperty('--hy', `${cy}px`);
      builtStep = 0; build(); kick();
    }
    function rot(wx: number, wy: number, wz: number): [number, number, number] {
      const sl = Math.sin(lambda), cl = Math.cos(lambda), st = Math.sin(tilt), ct = Math.cos(tilt);
      const x0 = wx * cl + wz * sl, z0 = wz * cl - wx * sl;
      return [x0, wy * ct - z0 * st, wy * st + z0 * ct];
    }
    const live = () => !reduce.matches && visible && !document.hidden;
    function kick() {
      if (!raf) raf = requestAnimationFrame(frame);
    }
    function frame(now: number) {
      raf = 0;
      const dt = Math.min(64, now - (last || now));
      last = now;
      const on = live();
      if (on && !dragging) {
        const base = TAU / TURN_MS;
        vel += (base - vel) * Math.min(1, dt / 800);
        lambda += vel * dt;
      }
      draw(now, on);
      if (on || dragging) kick();
      else last = 0;
    }

    function draw(now: number, on: boolean) {
      if (!w || !ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const still = reduce.matches;
      const tAge = still ? 1e9 : now - t0;
      const fadeIn = clamp((tAge - 300) / 700, 0, 1);
      const P: Pos[] = NODES.map((n) => {
        const [x, y, z] = rot(n.wx, n.wy, n.wz);
        return { x: cx + x * R, y: cy - y * R, z };
      });

      // one deploy at a time, to a server facing the visitor
      if (still) {
        let best = 0;
        P.forEach((p, i) => { if (p.z > P[best].z) best = i; });
        dep = { i: best, s: now - (T_TRAVEL + T_BUILD + 600), sent: true };
      } else if (on) {
        if (dep && now - dep.s > T_TOTAL) { dep = null; nextDep = now + 500; }
        if (!dep && now > nextDep) {
          const cand = P.map((p, i) => [p, i] as const).filter(([p, i]) => p.z > 0.45 && i !== lastI);
          if (cand.length) {
            const [, i] = cand[(Math.random() * cand.length) | 0];
            dep = { i, s: now, sent: false }; lastI = i;
          } else nextDep = now + 400;
        }
        if (dep && !dep.sent) {
          dep.sent = true;
          hub.classList.remove('is-sending'); void hub.offsetWidth; hub.classList.add('is-sending');
        }
      }
      const dt = dep ? now - dep.s : -1e9;
      const travel = dep ? clamp(dt / T_TRAVEL, 0, 1) : 0;
      const lit = dep && dt > T_TRAVEL ? clamp(1 - (dt - (T_TOTAL - T_FADE)) / T_FADE, 0, 1) : 0;

      // sphere, atmosphere, land
      const g = ctx.createRadialGradient(cx, cy, R * 0.82, cx, cy, R * 1.14);
      g.addColorStop(0, rgba(c.brand, 0)); g.addColorStop(0.16, rgba(c.brand, 0.09)); g.addColorStop(1, rgba(c.brand, 0));
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, R * 1.14, 0, TAU); ctx.fill();
      ctx.fillStyle = rgba(c.surface, 0.55); ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU); ctx.fill();
      ctx.strokeStyle = rgba(c.line, 1); ctx.lineWidth = 1; ctx.stroke();
      const sl = Math.sin(lambda), cl = Math.cos(lambda), sT = Math.sin(tilt), cT = Math.cos(tilt);
      const alphas = [0.14, 0.22, 0.34, 0.48];
      const paths = alphas.map(() => new Path2D());
      for (let k = 0; k < pts.length; k += 4) {
        const cp = pts[k], sp = pts[k + 1], sth = pts[k + 2], cth = pts[k + 3];
        const s = sth * cl + cth * sl, co = cth * cl - sth * sl, x0 = cp * s, z0 = cp * co;
        const z = sp * sT + z0 * cT;
        if (z <= 0) continue;
        const y = sp * cT - z0 * sT, sx = cx + x0 * R, sy = cy - y * R;
        const b = Math.min(3, (z * 4) | 0), r = gap * 0.3 * (0.55 + 0.45 * z);
        paths[b].moveTo(sx + r, sy); paths[b].arc(sx, sy, r, 0, TAU);
      }
      ctx.fillStyle = rgba(c.brand, 1);
      paths.forEach((p, i) => { ctx.globalAlpha = alphas[i] * fadeIn; ctx.fill(p); });
      ctx.globalAlpha = 1;

      // arcs from the mark
      const ctrl = (p: Pos) => {
        const mx = (cx + p.x) / 2, my = (cy + p.y) / 2, dist = Math.hypot(p.x - cx, p.y - cy);
        let dx = mx - cx, dy = my - cy, d = Math.hypot(dx, dy);
        if (d < 1) { dx = 0; dy = -1; d = 1; }
        const k = dist * 0.3 + R * 0.04;
        return { x: mx + (dx / d) * k, y: my + (dy / d) * k };
      };
      const qpt = (p: Pos, k: { x: number; y: number }, t: number) => {
        const u = 1 - t;
        return { x: u * u * cx + 2 * u * t * k.x + t * t * p.x, y: u * u * cy + 2 * u * t * k.y + t * t * p.y };
      };
      const stroke = (p: Pos, t1: number, t2: number) => {
        const k = ctrl(p);
        ctx.beginPath();
        for (let s = 0; s <= 20; s++) {
          const q = qpt(p, k, t1 + ((t2 - t1) * s) / 20);
          if (s) ctx.lineTo(q.x, q.y); else ctx.moveTo(q.x, q.y);
        }
        ctx.stroke();
      };
      const visA = (p: Pos) => clamp(p.z / 0.3, 0, 1);
      ctx.lineCap = 'round';
      P.forEach((p, i) => {
        if (p.z <= 0) return;
        const appear = easeOut(clamp((tAge - 600 - i * 140) / 800, 0, 1));
        const a = visA(p) * appear;
        if (a <= 0.01) return;
        const active = dep && dep.i === i && dt > 0;
        ctx.strokeStyle = rgba(c.lanes[NODES[i].lane], (active ? 0.7 : 0.4) * a);
        ctx.lineWidth = active ? 1.5 : 1;
        ctx.setLineDash(active ? [] : [2, 4]);
        stroke(p, 0, appear);
      });
      ctx.setLineDash([]);

      // the deploy pulse
      if (dep && dt >= 0 && dt < T_TRAVEL && !still) {
        const p = P[dep.i], col = c.lanes[NODES[dep.i].lane], te = easeInOut(travel), t1 = Math.max(0, te - 0.22);
        ctx.strokeStyle = rgba(col, 0.95); ctx.lineWidth = 2.4; stroke(p, t1, te);
        const hd = qpt(p, ctrl(p), te);
        ctx.fillStyle = rgba(col, 0.22); ctx.beginPath(); ctx.arc(hd.x, hd.y, 7, 0, TAU); ctx.fill();
        ctx.fillStyle = rgba(col, 1); ctx.beginPath(); ctx.arc(hd.x, hd.y, 2.8, 0, TAU); ctx.fill();
      }

      // the beacon: a column of light from the server that got the deploy
      if (dep && dt > T_TRAVEL) {
        const p = P[dep.i], rise = easeOut(clamp((dt - T_TRAVEL) / 700, 0, 1)), Lb = R * 0.7 * rise, a = lit * visA(p);
        const gr = ctx.createLinearGradient(p.x, p.y, p.x, p.y - Lb);
        gr.addColorStop(0, rgba(c.peach, 0.95 * a)); gr.addColorStop(0.35, rgba(c.brand, 0.55 * a)); gr.addColorStop(1, rgba(c.brand, 0));
        ctx.fillStyle = gr;
        ctx.globalAlpha = 0.35; ctx.fillRect(p.x - 5, p.y - Lb, 10, Lb);
        ctx.globalAlpha = 1; ctx.fillRect(p.x - 1.5, p.y - Lb, 3, Lb);
        ctx.fillStyle = rgba(c.peach, 0.14 * a); ctx.beginPath(); ctx.ellipse(p.x, p.y, 16 * rise, 6 * rise, 0, 0, TAU); ctx.fill();
      }

      // servers
      P.map((p, i) => i).sort((a, b) => P[a].z - P[b].z).forEach((i) => {
        const p = P[i];
        if (p.z <= 0) return;
        const a = visA(p) * fadeIn;
        if (a <= 0.01) return;
        const col = c.lanes[NODES[i].lane], active = dep && dep.i === i, l = active ? lit : 0, s = 7;
        if (active && dt > T_TRAVEL && dt < T_TRAVEL + 1000 && !still) {
          const pt = (dt - T_TRAVEL) / 1000;
          ctx.strokeStyle = rgba(col, (1 - pt) * 0.85); ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.arc(p.x, p.y, 5 + easeOut(pt) * 18, 0, TAU); ctx.stroke();
        }
        ctx.globalAlpha = a;
        if (l > 0) { ctx.fillStyle = rgba(col, 0.22 * l); ctx.fillRect(p.x - s - 4, p.y - s - 4, (s + 4) * 2, (s + 4) * 2); }
        ctx.fillStyle = rgba(c.paper, 1); ctx.fillRect(p.x - s / 2 - 2, p.y - s / 2 - 2, s + 4, s + 4);
        ctx.fillStyle = rgba(col, 1); ctx.fillRect(p.x - s / 2, p.y - s / 2, s, s);
        ctx.globalAlpha = 1;
      });

      // the status card
      if (dep && dt > T_TRAVEL - 150) {
        const i = dep.i, p = P[i], col = c.lanes[NODES[i].lane];
        const ap = clamp((dt - T_TRAVEL + 150) / 250, 0, 1) * lit * visA(p);
        const running = dt > T_TRAVEL + T_BUILD, lane = LANES[NODES[i].lane], state = running ? 'Running' : 'Deploying';
        ctx.textBaseline = 'middle';
        ctx.font = `500 11px ${font}`; const w1 = ctx.measureText(lane).width;
        ctx.font = `600 12.5px ${font}`; const w2 = ctx.measureText(state).width + 14;
        const bw = Math.max(w1 + 14, w2) + 22, bh = 42;
        let bx = p.x + 12 + bw > w - 4 ? p.x - 12 - bw : p.x + 12;
        bx = clamp(bx, 2, w - bw - 2);
        const by = clamp(p.y - bh / 2, 2, h - bh - 2);
        ctx.globalAlpha = ap;
        ctx.fillStyle = rgba(c.surface, 0.96); ctx.strokeStyle = rgba(col, 0.75); ctx.lineWidth = 1;
        ctx.beginPath(); ctx.roundRect(bx, by, bw, bh, 8); ctx.fill(); ctx.stroke();
        ctx.fillStyle = rgba(col, 1); ctx.fillRect(bx + 11, by + 10, 6, 6);
        ctx.font = `500 11px ${font}`; ctx.fillStyle = rgba(c.muted, 1); ctx.fillText(lane, bx + 22, by + 13.5);
        if (running) {
          ctx.fillStyle = rgba(c.live, 1); ctx.beginPath(); ctx.arc(bx + 14, by + 29, 3.2, 0, TAU); ctx.fill();
        } else {
          const sp = now / 140;
          ctx.strokeStyle = rgba(c.brand, 1); ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(bx + 14, by + 29, 3.6, sp, sp + 4.2); ctx.stroke();
        }
        ctx.font = `600 12.5px ${font}`; ctx.fillStyle = rgba(running ? c.live : c.ink, 1); ctx.fillText(state, bx + 22, by + 29.5);
        ctx.globalAlpha = 1;
      }
    }

    // drag to turn
    let lx: number | null = null, lt = 0;
    canvas.addEventListener('pointerdown', (e) => {
      lx = e.clientX; lt = performance.now(); dragging = true; vel = 0;
      canvas.setPointerCapture(e.pointerId); kick();
    });
    canvas.addEventListener('pointermove', (e) => {
      if (lx === null) return;
      const now = performance.now(), d = (e.clientX - lx) / R;
      lambda += d; vel = d / Math.max(8, now - lt); lx = e.clientX; lt = now; kick();
    });
    const up = () => { lx = null; dragging = false; kick(); };
    canvas.addEventListener('pointerup', up);
    canvas.addEventListener('pointercancel', up);

    new ResizeObserver(resize).observe(wrap);
    new IntersectionObserver((e) => { visible = e[0].isIntersecting; kick(); }).observe(wrap);
    document.addEventListener('visibilitychange', kick);
    reduce.addEventListener('change', kick);
    const recolor = () => requestAnimationFrame(() => { c = colors(); font = getComputedStyle(document.body).fontFamily; kick(); });
    new MutationObserver(recolor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
    document.fonts?.ready.then(recolor);

    fetch('/globe/land.bin')
      .then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(r.status)))
      .then((buf) => { land = new Uint8Array(buf); builtStep = 0; build(); t0 = performance.now(); nextDep = t0 + 1600; kick(); })
      .catch(() => {});
    resize();
  }

  const el = document.querySelector<HTMLElement>('[data-hero-globe]');
  if (el) {
    const go = () => start(el);
    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 600 });
    else setTimeout(go, 120);
  }
</script>
