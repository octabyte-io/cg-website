---
interface Props { trail: { name: string; path: string }[] }
const { trail } = Astro.props;
const all = [{ name: 'Home', path: '/' }, ...trail];
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {all.map((c, i) => (
      <li>{i < all.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  /* The slash ends its line rather than starting the next one when the trail wraps. */
  li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
    color: var(--line-strong);
  }
  a {
    display: inline-block;
    padding-block: 0.65rem;
    margin-block: -0.65rem;
    color: var(--muted);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--ink);
    }
  }
</style>
