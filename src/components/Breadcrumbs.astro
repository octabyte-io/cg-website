---
interface Props { trail: { name: string; path: string }[] }
const { trail } = Astro.props;
const all = [{ name: 'Home', path: '/' }, ...trail];
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {all.map((c, i) => (
      <li>{i < all.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--line-strong);
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
</style>
