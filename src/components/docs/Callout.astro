---
// A side note in running copy. `note` explains, `tip` saves time, `warn` is something that cannot be
// undone or will cost something, `limit` is something Cloudgate does not do or a gate (role, plan).
interface Props { type?: 'note' | 'tip' | 'warn' | 'limit'; title?: string }
const { type = 'note', title } = Astro.props;
const label = { note: 'Note', tip: 'Tip', warn: 'Careful', limit: 'Limit' }[type];
---
<aside class:list={['callout', `callout--${type}`]} aria-label={title ?? label}>
  <svg class="callout-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    {type === 'warn' ? (
      <path fill="currentColor" d="M10 2.2 1.6 17h16.8L10 2.2Zm-.9 5h1.8v5.2H9.1V7.2Zm0 6.6h1.8v1.8H9.1v-1.8Z" />
    ) : type === 'limit' ? (
      <path fill="currentColor" d="M10 1.8a8.2 8.2 0 1 0 0 16.4 8.2 8.2 0 0 0 0-16.4Zm0 1.8a6.4 6.4 0 0 1 5.1 10.3L6.1 4.9A6.4 6.4 0 0 1 10 3.6ZM4.9 6.1l9 9A6.4 6.4 0 0 1 4.9 6.1Z" />
    ) : type === 'tip' ? (
      <path fill="currentColor" d="M10 1.8a6 6 0 0 0-3.6 10.8c.5.4.8 1 .8 1.6v.6h5.6v-.6c0-.6.3-1.2.8-1.6A6 6 0 0 0 10 1.8ZM7.4 16.4h5.2v1.8H7.4v-1.8Z" />
    ) : (
      <path fill="currentColor" d="M10 1.8a8.2 8.2 0 1 0 0 16.4 8.2 8.2 0 0 0 0-16.4Zm-.9 4h1.8v1.8H9.1V5.8Zm0 3.4h1.8v5.2H9.1V9.2Z" />
    )}
  </svg>
  <div class="callout-body">
    <p class="callout-title">{title ?? label}</p>
    <slot />
  </div>
</aside>
