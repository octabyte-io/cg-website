---
// The Cloudgate mark, drawn in the current brand colour so it follows the theme.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
const id = `m${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={className} width={size} height={Math.round((size * 37) / 58)} viewBox="3 15 58 37" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={`${id}a`}><polygon points="0,0 25,0 17,64 0,64" /></clipPath>
    <clipPath id={`${id}b`}><polygon points="28,0 44,0 36,64 20,64" /></clipPath>
    <clipPath id={`${id}c`}><polygon points="47,0 64,0 64,64 39,64" /></clipPath>
    <mask id={`${id}k`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="#fff" />
      <circle cx="31.7" cy="34" r="2.8" />
      <path d="M30.6 35 L29.4 42.5 H33.2 L32.8 35 Z" />
    </mask>
    <g id={`${id}s`}><rect x="3" y="33" width="58" height="19" rx="9.5" /><circle cx="19" cy="34" r="9.5" /><circle cx="37" cy="28" r="13" /><circle cx="50" cy="35.5" r="8" /></g>
  </defs>
  <g fill="var(--brand)" mask={`url(#${id}k)`}>
    <use href={`#${id}s`} clip-path={`url(#${id}a)`} />
    <use href={`#${id}s`} clip-path={`url(#${id}b)`} opacity=".75" />
    <use href={`#${id}s`} clip-path={`url(#${id}c)`} opacity=".5" />
  </g>
</svg>
